  const speedDatingControls = document.getElementById('speed-dating-controls');
  let speedDatingInterval: number | null = null;
  let currentRoomState = {
    userReady: false,
    opponentReady: false,
    timer: 0,
    userDecision: null as 'pass' | 'date' | null,
  };

  // Users will be loaded from Firebase
  let users: any[] = [];
  let userList: any[] = [];

  // Chat State
  let chatbotSession: Chat | null = null;
  let isChatbotActive = false;
  let currentChatUserId: string | null = null;

  // App State
  let currentUserProfile = {
      avatar: 'https://placehold.co/120x120/E1E1E1/BDBDBD?text=You',
      additionalPhotos: [] as string[],
      name: 'Your Name',
      about: '',
      prompts: {
        prompt1: '',
        prompt2: ''
      },
      age: 25,
      specialty: 'General Practice',
      location: 'Your Location',
      interests: [] as string[],
      earnedBadges: ['verified'] as string[],
      superLikes: 3,
      giftPoints: 100,
      lastLogin: 0,
      loginStreak: 0,
      isPremium: false,
      darkMode: false,
      verificationStatus: 'unverified' as 'unverified' | 'pending' | 'verified',
      verificationIdUrl: '',
      messagesSent: 0,
      adsWatchedPerTier: {} as Record<string, number>,
      videoMinutes: 0
  };
  let currentPremiumGift: Gift | null = null;
  let blockedUsers: string[] = [];
  let boostEndTime: number | null = null;
  let boostInterval: number | null = null;
  let currentUserInView: any = null;
  let usersWhoLikedYou: string[] = []; // Will be loaded from Firebase

  // --- FIREBASE DATA FUNCTIONS ---

  // Load users from Firebase
  async function loadUsersFromFirebase() {
    try {
      const usersCollection = collection(db, 'users');
      const usersQuery = query(usersCollection, limit(50)); // Load first 50 users
      const snapshot = await getDocs(usersQuery);

      users = snapshot.docs.map(doc => ({
        id: doc.id,
        ...doc.data()
      })).filter(user => user.id !== auth.currentUser?.uid); // Exclude current user

      userList = [...users];
      console.log(`Loaded ${users.length} users from Firebase`);

      // Load swipe cards for home page
      loadSwipeCards();

      // Update UI if on home page
      if (window.location.hash === '#home' || window.location.hash === '') {
        renderHomePage();
      }
    } catch (error) {
      console.error('Error loading users from Firebase:', error);
      // Fallback to empty array if Firebase fails
      users = [];
      userList = [];
    }
  }

  // Load likes data from Firebase
  async function loadLikesFromFirebase() {
    if (!auth.currentUser) return;

    try {
      const likesCollection = collection(db, 'likes');
      const likesQuery = query(
        likesCollection,
        where('likedUserId', '==', auth.currentUser.uid),
        where('type', '==', 'like')
      );
      const snapshot = await getDocs(likesQuery);

      usersWhoLikedYou = snapshot.docs.map(doc => doc.data().likerId);
      console.log(`Loaded ${usersWhoLikedYou.length} likes from Firebase`);
    } catch (error) {
      console.error('Error loading likes from Firebase:', error);
      usersWhoLikedYou = [];
    }
  }

  // Load user profile from Firebase
  async function loadUserProfileFromFirebase(userId: string) {
    try {
      const userDoc = doc(db, 'users', userId);
      const userSnap = await getDoc(userDoc);

      if (userSnap.exists()) {
        const userData = userSnap.data();
        currentUserProfile = {
          ...currentUserProfile,
          ...userData,
          // Ensure required fields have defaults
          name: userData.name || 'Loading...',
          about: userData.about || '',
          age: userData.age || 25,
          specialty: userData.specialty || 'Loading...',
          location: userData.location || 'Loading...',
          interests: userData.interests || [],
          prompts: userData.prompts || { prompt1: '', prompt2: '' },
          additionalPhotos: userData.additionalPhotos || [],
          earnedBadges: userData.earnedBadges || [],
          profileViews: userData.profileViews || 0
        };
        console.log('Loaded user profile from Firebase:', currentUserProfile);
      }
    } catch (error) {
      console.error('Error loading user profile from Firebase:', error);
    }
  }

  // Load vent posts from Firebase
  async function loadVentPostsFromFirebase() {
    try {
      const postsCollection = collection(db, 'ventPosts');
      const postsQuery = query(postsCollection, orderBy('createdAt', 'desc'), limit(20));
      const snapshot = await getDocs(postsQuery);

      ventPosts = snapshot.docs.map(doc => ({
        id: doc.id,
        ...doc.data()
      }));
      console.log(`Loaded ${ventPosts.length} vent posts from Firebase`);

      // Update UI if on vent page
      if (window.location.hash === '#vent') {
        renderVentPage();
      }
    } catch (error) {
      console.error('Error loading vent posts from Firebase:', error);
      ventPosts = [];
    }
  }

  // Initialize Firebase data loading
  async function initializeFirebaseData() {
    if (auth.currentUser) {
      console.log('Initializing Firebase data for user:', auth.currentUser.uid);
      try {
        await Promise.all([
          loadUsersFromFirebase(),
          loadLikesFromFirebase(),
          loadUserProfileFromFirebase(auth.currentUser.uid),
          loadVentPostsFromFirebase()
        ]);
        console.log('All Firebase data loaded successfully');
      } catch (error) {
        console.error('Error loading Firebase data:', error);
        // Don't throw the error, just log it to prevent blocking login
      }
    } else {
      console.log('No current user, skipping Firebase data initialization');
    }
  }

  // --- CHAT PERSISTENCE HELPERS ---
  function getChatId(userId: string): string {
    if (!auth.currentUser) return '';
    // Create a consistent chat ID for both users
    const userIds = [auth.currentUser.uid, userId].sort();
    return `chat_${userIds[0]}_${userIds[1]}`;
  }

  async function loadMessages(chatId: string): Promise<Message[]> {
    if (!auth.currentUser || !chatId) return [];

    try {
      // Load messages from Firebase
      const messagesRef = collection(db, 'chats', chatId, 'messages');
      const messagesQuery = query(messagesRef, orderBy('timestamp', 'asc'), limit(100));
      const snapshot = await getDocs(messagesQuery);

      return snapshot.docs.map(doc => ({
        id: doc.id,
        ...doc.data()
      } as Message));
    } catch (error) {
      console.error('Error loading messages:', error);
      return [];
    }
  }

  async function saveMessage(chatId: string, message: Message) {
    if (!auth.currentUser || !chatId) return;

    try {
      // Save message to Firebase
      const messagesRef = collection(db, 'chats', chatId, 'messages');
      const messageData = {
        ...message,
        senderId: auth.currentUser.uid,
        receiverId: currentChatUserId,
        timestamp: new Date(),
        status: 'sent'
      };

      await addDoc(messagesRef, messageData);

      // Update chat metadata
      const chatRef = doc(db, 'chats', chatId);
      await setDoc(chatRef, {
        participants: [auth.currentUser.uid, currentChatUserId],
        lastMessage: message.text || (message.gift ? `🎁 ${message.gift.name}` : 'Message'),
        lastMessageTime: new Date(),
        updatedAt: new Date()
      }, { merge: true });

    } catch (error) {
      console.error('Error saving message:', error);
    }
  }

  async function updateMessage(chatId: string, message: Message) {
    if (!auth.currentUser || !chatId) return;

    try {
      // Find and update the message in Firebase
      const messagesRef = collection(db, 'chats', chatId, 'messages');
      const messageQuery = query(messagesRef, where('timestamp', '==', message.timestamp));
      const snapshot = await getDocs(messageQuery);

      if (!snapshot.empty) {
        const messageDoc = snapshot.docs[0];
        await updateDoc(messageDoc.ref, {
          reactions: message.reactions || null
        });
        console.log('Message updated in Firebase');
      }
    } catch (error) {
      console.error('Error updating message:', error);
    }
  }
  
  // --- GIFT INVENTORY & PERSISTENCE ---
  type GiftInventory = Record<string, Gift & { count: number }>;

  function getSendableGiftInventory(): GiftInventory {
    if (!auth.currentUser) return {};
    const saved = localStorage.getItem(`user_sendable_gift_inventory_${auth.currentUser.uid}`);
    return saved ? JSON.parse(saved) : {};
  }
  function saveSendableGiftInventory(inventory: GiftInventory) {
      if (!auth.currentUser) return;
      localStorage.setItem(`user_sendable_gift_inventory_${auth.currentUser.uid}`, JSON.stringify(inventory));
      renderGiftsPage();
  }
  function addGiftToSendableInventory(gift: Gift) {
      const inventory = getSendableGiftInventory();
      inventory[gift.name] = { ...gift, count: (inventory[gift.name]?.count || 0) + 1 };
      saveSendableGiftInventory(inventory);
  }
  async function sendGiftFromInventory(gift: Gift, recipientUserId: string) {
    const inventory = getSendableGiftInventory();
    if (!inventory[gift.name] || inventory[gift.name].count === 0) {
        showToast("You don't have this gift to send!");
        return;
    }
    inventory[gift.name].count--;
    if (inventory[gift.name].count === 0) delete inventory[gift.name];
    saveSendableGiftInventory(inventory);
    
    const chatId = getChatId(recipientUserId);
    const giftMessage: Message = { text: '', type: 'gift', status: 'sent', timestamp: Date.now(), gift: gift };
    await saveMessage(chatId, giftMessage);
    if(currentChatUserId === recipientUserId) appendMessage(giftMessage);
    
    if (!currentUserProfile.earnedBadges.includes('first-gift')) {
        currentUserProfile.earnedBadges.push('first-gift');
        renderProfilePage();
    }
    showToast(`You sent a ${gift.name}!`);
    sendGiftModal?.classList.add('hidden');
  }

  // --- BLOCK/UNBLOCK HELPERS ---
  function getBlockedUsers(): string[] { const saved = localStorage.getItem('blocked_users'); return saved ? JSON.parse(saved) : []; }
  function saveBlockedUsers() { localStorage.setItem('blocked_users', JSON.stringify(blockedUsers)); }
  function isUserBlocked(userId: string): boolean { return blockedUsers.includes(userId); }
  function blockUser(userId: string) {
    if (!userId || isUserBlocked(userId)) return;
    blockedUsers.push(userId);
    saveBlockedUsers();
    showToast(`User has been blocked.`);
    chatOptionsModal?.classList.add('hidden');
    backToListBtn?.dispatchEvent(new MouseEvent('click'));
    document.querySelector(`.message-thread-item[data-user-id="${userId}"]`)?.remove();
    userList = userList.filter(u => u.id !== userId);
    loadSwipeCards();
  }
  function unblockUser(userId: string) {
    if (!userId || !isUserBlocked(userId)) return;
    blockedUsers = blockedUsers.filter(id => id !== userId);
    saveBlockedUsers();
    const unblockedUser = users.find(u => u.id === userId);
    if(unblockedUser) {
        if(!userList.find(u => u.id === userId)) userList.push(unblockedUser);
        showToast(`${unblockedUser.name} has been unblocked.`);
    }
    renderBlockedUsersPage();
  }

  // --- DARK MODE LOGIC ---
  function applyDarkMode(isDark: boolean) {
      currentUserProfile.darkMode = isDark;
      document.body.classList.toggle('dark-mode', isDark);
      localStorage.setItem('nurse_mingle_dark_mode', isDark.toString());
  }

  // --- DAILY REWARD LOGIC ---
  const dailyRewards = [
      { name: "50 Gift Points", icon: "fas fa-coins", desc: "Start your collection!", action: () => currentUserProfile.giftPoints += 50 },
      { name: "1 Super Like", icon: "fas fa-star", desc: "Make someone's day!", action: () => currentUserProfile.superLikes += 1 },
      { name: "100 Gift Points", icon: "fas fa-coins", desc: "Getting closer to a gift!", action: () => currentUserProfile.giftPoints += 100 },
      { name: "Profile Boost", icon: "fas fa-bolt", desc: "15 minutes of fame!", action: () => startBoostTimer(15) },
      { name: "200 Gift Points", icon: "fas fa-coins", desc: "You're on a roll!", action: () => currentUserProfile.giftPoints += 200 },
      { name: "3 Super Likes", icon: "fas fa-star", desc: "Get noticed by your favorites!", action: () => currentUserProfile.superLikes += 3 },
      { name: "500 Gift Points", icon: "fas fa-gift", desc: "A special gift on us!", action: () => currentUserProfile.giftPoints += 500 },
  ];
  function checkDailyLogin() {
    const lastLogin = new Date(currentUserProfile.lastLogin);
    const now = new Date();
    const isNewDay = now.toDateString() !== lastLogin.toDateString();

    if (isNewDay) {
        const yesterday = new Date();
        yesterday.setDate(now.getDate() - 1);
        if (lastLogin.toDateString() === yesterday.toDateString()) {
            currentUserProfile.loginStreak++;
        } else {
            currentUserProfile.loginStreak = 1;
        }
        currentUserProfile.lastLogin = now.getTime();
        showDailyRewardModal();
    }
  }
  function showDailyRewardModal() {
    const streak = Math.min(currentUserProfile.loginStreak, 7);
    const reward = dailyRewards[streak - 1];
    
    (document.getElementById('daily-reward-title') as HTMLElement).textContent = `Day ${streak} Login Reward!`;
    (document.getElementById('daily-reward-subtitle') as HTMLElement).textContent = streak < 7 ? `Come back tomorrow for an even better reward!` : "You've completed a full week!";
    (document.getElementById('daily-reward-item') as HTMLElement).innerHTML = `
        <div id="daily-reward-icon"><i class="${reward.icon}"></i></div>
        <h3 id="daily-reward-name">${reward.name}</h3>
        <p id="daily-reward-desc">${reward.desc}</p>
    `;
    dailyRewardModal?.classList.remove('hidden');
  }
  claimRewardBtn?.addEventListener('click', () => {
    const streak = Math.min(currentUserProfile.loginStreak, 7);
    dailyRewards[streak - 1].action();
    dailyRewardModal?.classList.add('hidden');
    showToast("Reward claimed!");
    updateGiftPointsDisplay();
  });


  // --- INITIALIZATION ---
  createFallingObjects();
  createSparkleTrail();
  blockedUsers = getBlockedUsers();
  renderGiftsPage();

  // Initialize call notifications listener
  auth.onAuthStateChanged((user) => {
    if (user) {
      listenForCallNotifications();
    }
  });
  renderMessageThreads();
  
  const savedDarkMode = localStorage.getItem('nurse_mingle_dark_mode') === 'true';
  darkModeToggle.checked = savedDarkMode;
  applyDarkMode(savedDarkMode);


  // --- ONBOARDING & APP FLOW ---
  gotoAuthBtn?.addEventListener('click', () => {
    userRequestedAuth = true; // Mark that user manually requested auth
    welcomeContainer?.classList.add('hidden');
    authContainer?.classList.remove('hidden');
  });
  // Handle auth form with separate button listeners
  let isSignUpAction = false;
  let isLoginAction = false;

  // Add click listeners to determine which button was pressed
  authForm?.querySelector('.btn-primary')?.addEventListener('click', async (e) => {
    e.preventDefault();
    e.stopPropagation();
    console.log('Signup button clicked');
    isSignUpAction = true;
    isLoginAction = false;
    await handleAuthSubmission();
  });

  authForm?.querySelector('.btn-secondary')?.addEventListener('click', async (e) => {
    e.preventDefault();
    e.stopPropagation();
    console.log('Login button clicked');
    isSignUpAction = false;
    isLoginAction = true;
    await handleAuthSubmission();
  });

  // Prevent form submission to avoid conflicts
  authForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    console.log('Form submission prevented - using button handlers instead');
  });

  // Unified authentication handler
  async function handleAuthSubmission() {
    if (!authForm) return;

    const formData = new FormData(authForm);
    const email = formData.get('email') as string;
    const password = formData.get('password') as string;

    if (!email?.trim()) {
      alert('Please enter your email address');
      return;
    }

    if (!password?.trim()) {
      alert('Please enter your password');
      return;
    }

    console.log('Starting authentication process...');
    console.log('Form data collected:', { email, passwordLength: password.length });

    // Firebase connectivity will be tested through actual auth operation

    // Mark that user is attempting authentication
    userRequestedAuth = true;

    try {
      if (isSignUpAction) {
        console.log('Creating new user account...');
        await createUserWithEmailAndPassword(auth, email, password);
        console.log('User account created successfully');
        // New user - will be handled by onAuthStateChanged to go to profile setup
      } else {
        console.log('Signing in existing user...');
        console.log('Email:', email);
        console.log('Password length:', password.length);
        console.log('Auth object:', auth);

        const userCredential = await signInWithEmailAndPassword(auth, email, password);
        console.log('Firebase signInWithEmailAndPassword completed');
        console.log('User credential:', userCredential);
        console.log('User:', userCredential.user);
        console.log('User signed in successfully');

        // Force login flow since onAuthStateChanged might not trigger properly
        console.log('Forcing login flow completion...');
        await handleLoginSuccess(userCredential.user);
      }
    } catch (error: any) {
      console.error('Authentication error:', error);
      let errorMessage = error.message;

      // Reset auth flag on error
      userRequestedAuth = false;

      // Provide more user-friendly error messages
      if (error.code === 'auth/invalid-credential') {
        errorMessage = 'Invalid email or password. Please check your credentials.';
      } else if (error.code === 'auth/email-already-in-use') {
        errorMessage = 'This email is already registered. Try logging in instead.';
      } else if (error.code === 'auth/weak-password') {
        errorMessage = 'Password is too weak. Please use at least 6 characters.';
      } else if (error.code === 'auth/invalid-email') {
        errorMessage = 'Please enter a valid email address.';
      } else if (error.code === 'auth/user-not-found') {
        errorMessage = 'No account found with this email. Please sign up first.';
      } else if (error.code === 'auth/wrong-password') {
        errorMessage = 'Incorrect password. Please try again.';
      } else if (error.code === 'auth/too-many-requests') {
        errorMessage = 'Too many failed login attempts. Please try again later.';
      }

      alert('Authentication failed: ' + errorMessage);
    }
  }

  // Handle successful login
  async function handleLoginSuccess(user: any) {
    try {
      console.log('Handling login success for user:', user.uid);

      // Load user profile from Firestore
      const userDoc = doc(db, 'users', user.uid);
      const userSnap = await getDoc(userDoc);

      if (userSnap.exists()) {
        const userData = userSnap.data();
        console.log('User profile loaded:', userData);

        // Update current user profile
        currentUserProfile = { ...currentUserProfile, ...userData };

        // Load Firebase data
        console.log('Loading Firebase data...');
        await initializeFirebaseData();
        console.log('Firebase data loaded successfully');

        // Update UI
        console.log('Updating UI for successful login...');
        welcomeContainer?.classList.add('hidden');
        authContainer?.classList.add('hidden');
        profileSetupContainer?.classList.add('hidden');
        appShell?.classList.remove('hidden');

        // Navigate to home
        console.log('Navigating to home page...');
        navigateTo('home');

        // Reset flags
        isLoginAction = false;
        isSignUpAction = false;
        userRequestedAuth = false;

        console.log('Login completed successfully!');
      } else {
        console.log('User profile not found, redirecting to profile setup');
        // New user or incomplete profile - redirect to profile setup
        welcomeContainer?.classList.add('hidden');
        authContainer?.classList.add('hidden');
        appShell?.classList.add('hidden');
        profileSetupContainer?.classList.remove('hidden');
      }
    } catch (error) {
      console.error('Error in handleLoginSuccess:', error);
      alert('Login completed but there was an error loading your profile. Please try again.');
    }
  }

  profileForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!auth.currentUser) {
      showToast('Please sign in first', 'error');
      return;
    }

    // Clear any existing errors
    clearFormErrors();

    // Perform comprehensive validation
    const validation = validateProfileForm();
    if (!validation.isValid) {
      showFormErrors(validation);
      return;
    }

    // Show loading state
    const submitButton = (e.target as HTMLFormElement).querySelector('button[type="submit"]');
    if (submitButton) {
      submitButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';
      submitButton.disabled = true;
    }

    // Add visual feedback
    const formContainer = document.getElementById('profile-setup-container')?.querySelector('.card');
    if (formContainer) {
      formContainer.style.opacity = '0.7';
    }

    try {
      console.log('Starting enhanced profile save process...');

      // Update current profile with validated data
      const nameField = document.getElementById('full-name') as HTMLInputElement;
      const aboutField = document.getElementById('about') as HTMLTextAreaElement;
      const ageField = document.getElementById('age-slider') as HTMLInputElement;
      const specialtyField = document.getElementById('specialty') as HTMLSelectElement;
      const locationField = document.getElementById('location') as HTMLInputElement;
      const prompt2Field = document.getElementById('profile-prompt-2') as HTMLInputElement;

      currentUserProfile.name = nameField.value.trim();
      currentUserProfile.about = aboutField?.value.trim() || '';
      currentUserProfile.age = parseInt(ageField?.value || '25', 10);
      currentUserProfile.specialty = specialtyField.value;
      currentUserProfile.location = locationField.value.trim();
      currentUserProfile.interests = Array.from(profileForm.querySelectorAll('.interest-tag.active')).map(tag => tag.textContent || '').filter(Boolean);
      currentUserProfile.prompts.prompt1 = (document.getElementById('profile-prompt-1') as HTMLInputElement)?.value || '';
      currentUserProfile.prompts.prompt2 = prompt2Field?.value || '';

      // Enhanced avatar upload with progress tracking
      const avatarFile = avatarUpload.files?.[0];
      if (avatarFile) {
        console.log('Starting enhanced avatar upload...');
        showToast('Uploading your profile photo...', 'info');

        // Show upload progress
        const uploadProgress = document.createElement('div');
        uploadProgress.className = 'upload-progress';
        uploadProgress.innerHTML = `
          <div class="progress-bar">
            <div class="progress-fill" style="width: 0%"></div>
          </div>
          <div class="progress-text">Uploading: 0%</div>
        `;

        nameField.parentNode?.appendChild(uploadProgress);

        const progressRef = ref(storage, `avatars/${auth.currentUser.uid}`);
        const uploadTask = uploadBytesResumable(progressRef, avatarFile);

        // Track upload progress
        uploadTask.on(
          'state_changed',
          (snapshot) => {
            const progress = (snapshot.bytesTransferred / snapshot.totalBytes) * 100;
            const progressText = uploadProgress.querySelector('.progress-text');
            const progressFill = uploadProgress.querySelector('.progress-fill');
            if (progressText) progressText.textContent = `Uploading: ${Math.round(progress)}%`;
            if (progressFill) progressFill.style.width = `${progress}%`;
            console.log('Upload progress:', progress);
          },
          (error) => {
            console.error('Avatar upload error:', error);
            uploadProgress.remove();
            showToast('Failed to upload profile photo. Please try again.', 'error');
          },
          async () => {
            try {
              const downloadURL = await getDownloadURL(uploadTask.snapshot.ref);
              currentUserProfile.avatar = downloadURL;
              uploadProgress.remove();
              showToast('Profile photo uploaded successfully! 📸', 'success');

              // Continue with the rest of the profile save process
              await completeProfileSetup(formContainer as HTMLElement, submitButton as HTMLButtonElement);
            } catch (error) {
              console.error('Error getting download URL:', error);
              uploadProgress.remove();
              throw error;
            }
          }
        );
      } else {
        // No avatar upload, proceed with profile save
        await completeProfileSetup(formContainer as HTMLElement, submitButton as HTMLButtonElement);
      }

    } catch (error) {
      console.error('Enhanced profile save error:', error);
      let errorMessage = 'Failed to save profile. Please try again.';

      if (error.code === 'permission-denied') {
        errorMessage = 'Permission denied. Please check your internet connection and try again.';
      } else if (error.code === 'unavailable') {
        errorMessage = 'Service temporarily unavailable. Please try again in a moment.';
      } else if (error.message?.includes('storage')) {
        errorMessage = 'Failed to upload profile image. Please try a smaller image or try again.';
      } else if (error.message?.includes('network')) {
        errorMessage = 'Network error. Please check your internet connection and try again.';
      } else if (error.message?.includes('avatar')) {
        errorMessage = 'Profile photo upload failed. Please try a different image.';
      }

      showToast(errorMessage, 'error');
    } finally {
      // Reset form state
      if (submitButton) {
        submitButton.innerHTML = 'Complete Setup';
        submitButton.disabled = false;
      }
      if (formContainer) {
        formContainer.style.opacity = '1';
      }
    }
  });

  async function completeProfileSetup(formContainer: HTMLElement, submitButton: HTMLButtonElement) {
    const userData = {
      uid: auth.currentUser.uid,
      email: auth.currentUser.email,
      name: currentUserProfile.name,
      age: currentUserProfile.age,
      about: currentUserProfile.about || '',
      specialty: currentUserProfile.specialty,
      location: currentUserProfile.location,
      interests: currentUserProfile.interests,
      avatar: currentUserProfile.avatar || '',
      prompts: { prompt1: currentUserProfile.prompts.prompt1, prompt2: currentUserProfile.prompts.prompt2 },
      additionalPhotos: currentUserProfile.additionalPhotos || [],
      createdAt: serverTimestamp(),
      updatedAt: serverTimestamp(),
      likesCount: 0,
      messagesSent: currentUserProfile.messagesSent || 0,
      lastLoginAt: serverTimestamp(),
      giftPoints: currentUserProfile.giftPoints || 0,
      videoMinutesLeft: currentUserProfile.videoMinutesLeft || 0,
      superLikesLeft: currentUserProfile.superLikesLeft || 0,
      boostUntil: currentUserProfile.boostUntil || '',
      isPremium: currentUserProfile.isPremium || false,
      subscriptionTier: currentUserProfile.subscriptionTier || 'free',
      dailyLikes: currentUserProfile.dailyLikes || 0,
      dailySuperLikes: currentUserProfile.dailySuperLikes || 0,
      todayAdsWatched: currentUserProfile.todayAdsWatched || 0,
      lastAdDate: currentUserProfile.lastAdDate || today,
      lastLikeDate: currentUserProfile.lastLikeDate || today,
      earnedBadges: currentUserProfile.earnedBadges || [],
      verificationStatus: currentUserProfile.verificationStatus || 'unverified',
      verificationIdUrl: currentUserProfile.verificationIdUrl || ''
    };

    console.log('Saving verified profile to Firebase with data:', userData);

    const userDoc = doc(db, 'users', auth.currentUser.uid);
    await setDoc(userDoc, userData);

    currentUserProfile = { ...currentUserProfile, ...userData as any };

    showToast('🎉 Profile setup completed successfully!', 'success');
    renderProfilePage();

    await initializeFirebaseData();

    profileSetupContainer?.classList.add('hidden');
    appShell?.classList.remove('hidden');
    navigateTo('home');
    checkDailyLogin();
  }
    e.preventDefault();

    if (!auth.currentUser) {
      alert('Please sign in first');
      return;
    }

    // Validate required fields before proceeding
    const nameField = document.getElementById('full-name') as HTMLInputElement;
    const aboutField = document.getElementById('about') as HTMLTextAreaElement;
    const ageField = document.getElementById('age-slider') as HTMLInputElement;
    const specialtyField = document.getElementById('specialty') as HTMLSelectElement;
    const locationField = document.getElementById('location') as HTMLInputElement;

    if (!nameField?.value.trim()) {
      alert('Please enter your full name');
      nameField?.focus();
      return;
    }

    if (!specialtyField?.value) {
      alert('Please select your nursing specialty');
      specialtyField?.focus();
      return;
    }

    if (!locationField?.value.trim()) {
      alert('Please enter your location');
      locationField?.focus();
      return;
    }

    // Update local profile with validation
    currentUserProfile.name = nameField.value.trim();
    currentUserProfile.about = aboutField?.value.trim() || '';
    currentUserProfile.age = parseInt(ageField?.value || '25', 10);
    currentUserProfile.specialty = specialtyField.value;
    currentUserProfile.location = locationField.value.trim();
    currentUserProfile.interests = Array.from(profileForm.querySelectorAll('.interest-tag.active')).map(tag => tag.textContent || '').filter(Boolean);
    currentUserProfile.prompts.prompt1 = (document.getElementById('profile-prompt-1') as HTMLInputElement)?.value || '';

    try {
      console.log('Starting profile save process...');

      // Handle avatar upload to Firebase Storage if file selected
      const avatarFile = avatarUpload.files?.[0];
      if (avatarFile) {
        console.log('Uploading avatar to Firebase Storage...');
        const avatarRef = ref(storage, `avatars/${auth.currentUser.uid}`);
        await uploadBytes(avatarRef, avatarFile);
        currentUserProfile.avatar = await getDownloadURL(avatarRef);
        console.log('Avatar uploaded successfully');
      }

      // Prepare user data for Firebase with all required fields
      const userData = {
        // Core profile data
        name: currentUserProfile.name,
        about: currentUserProfile.about,
        age: currentUserProfile.age,
        specialty: currentUserProfile.specialty,
        location: currentUserProfile.location,
        interests: currentUserProfile.interests || [],
        avatar: currentUserProfile.avatar || 'https://placehold.co/120x120/E1E1E1/BDBDBD?text=User',

        // User prompts
        prompts: {
          prompt1: currentUserProfile.prompts.prompt1 || '',
          prompt2: currentUserProfile.prompts.prompt2 || ''
        },

        // Authentication data
        email: auth.currentUser.email,
        uid: auth.currentUser.uid,
        emailVerified: auth.currentUser.emailVerified,
        displayName: auth.currentUser.displayName || currentUserProfile.name,
        phoneNumber: auth.currentUser.phoneNumber || null,
        photoURL: currentUserProfile.avatar || auth.currentUser.photoURL,

        // User activity and status
        createdAt: new Date(),
        lastActive: new Date(),
        accountStatus: 'active',
        loginMethod: 'email',

        // Additional user properties with defaults
        giftPoints: currentUserProfile.giftPoints || 100,
        superLikes: currentUserProfile.superLikes || 5,
        videoMinutes: currentUserProfile.videoMinutes || 10,
        profileViews: currentUserProfile.profileViews || 0,
        isPremium: currentUserProfile.isPremium || false,
        subscriptionTier: currentUserProfile.subscriptionTier || 'free',
        darkMode: currentUserProfile.darkMode || false,
        loginStreak: currentUserProfile.loginStreak || 1,
        lastLogin: new Date().getTime(),
        earnedBadges: currentUserProfile.earnedBadges || [],
        messagesSent: currentUserProfile.messagesSent || 0,
        adsWatchedPerTier: currentUserProfile.adsWatchedPerTier || {},
        additionalPhotos: currentUserProfile.additionalPhotos || [],
        verificationStatus: currentUserProfile.verificationStatus || 'unverified',
        verificationIdUrl: currentUserProfile.verificationIdUrl || ''
      };

      console.log('Saving profile to Firebase with data:', userData);

      // Save profile to Firebase
      const userDoc = doc(db, 'users', auth.currentUser.uid);
      await setDoc(userDoc, userData);

      console.log('Profile saved to Firebase successfully');

      // Update currentUserProfile with the saved data
      currentUserProfile = { ...currentUserProfile, ...userData };

      renderProfilePage();

      // Load Firebase data first, then show app
      await initializeFirebaseData();

      profileSetupContainer?.classList.add('hidden');
      appShell?.classList.remove('hidden');
      navigateTo('home');
      checkDailyLogin();
    } catch (error) {
      console.error('Detailed error saving profile:', error);

      // Provide more specific error messages
      let errorMessage = 'Failed to save profile. Please try again.';

      if (error.code === 'permission-denied') {
        errorMessage = 'Permission denied. Please check your internet connection and try again.';
      } else if (error.code === 'unavailable') {
        errorMessage = 'Service temporarily unavailable. Please try again in a moment.';
      } else if (error.message?.includes('storage')) {
        errorMessage = 'Failed to upload profile image. Please try a smaller image or try again.';
      } else if (error.message?.includes('network')) {
        errorMessage = 'Network error. Please check your internet connection and try again.';
      }

      alert(errorMessage);
    }
  });

  // --- PROFILE LOGIC ---
  function renderProfilePage() {
    // Handle avatar loading with fallback
    if (profileAvatar) {
      if (currentUserProfile.avatar && currentUserProfile.avatar.trim() !== '') {
        profileAvatar.src = currentUserProfile.avatar;
        profileAvatar.onerror = () => {
          profileAvatar.src = 'https://placehold.co/120x120/00bcd4/FFFFFF?text=🏥';
        };
      } else {
        profileAvatar.src = 'https://placehold.co/120x120/00bcd4/FFFFFF?text=🏥';
      }
    }

    // Safely set profile name and info
    if (profileName) {
      const name = currentUserProfile.name || 'Loading...';
      const age = currentUserProfile.age || '';
      profileName.textContent = age ? `${name}, ${age}` : name;
    }

    // Add tier display to profile specialty line
    const tierDisplay = currentUserProfile.isPremium ?
      (currentUserProfile.subscriptionTier === 'premium' ? '👑 Premium' : '⭐ Plus') :
      '🆓 Free';

    if (profileSpecialty) {
      const specialty = currentUserProfile.specialty || 'Loading...';
      const location = currentUserProfile.location || 'Loading...';
      profileSpecialty.innerHTML = `
        <div style="display: flex; align-items: center; justify-content: space-between;">
          <span>${specialty} | ${location}</span>
          <span style="background: var(--primary); color: white; padding: 4px 8px; border-radius: 12px; font-size: 0.8rem; font-weight: bold;">
            ${tierDisplay}
          </span>
        </div>
      `;
    }

    if (profileAboutText) profileAboutText.textContent = currentUserProfile.about || 'No bio yet.';

    // Handle photos with proper loading and error states
    if (myPhotosContainer) {
        const photos = [currentUserProfile.avatar, ...currentUserProfile.additionalPhotos].filter(url => url && url.trim() !== '');
        if (photos.length > 0) {
          myPhotosContainer.innerHTML = photos.map(photoUrl => `
            <img src="${photoUrl}"
                 alt="Your photo"
                 loading="lazy"
                 onerror="this.src='https://placehold.co/150x150/00bcd4/FFFFFF?text=🏥'"
                 style="opacity: 0; transition: opacity 0.3s ease-in-out;"
                 onload="this.style.opacity = 1;">
          `).join('');
        } else {
          myPhotosContainer.innerHTML = `
            <div style="padding: 20px; text-align: center; color: #666;">
              <i class="fas fa-camera" style="font-size: 2rem; margin-bottom: 10px;"></i>
              <p>No photos uploaded yet</p>
            </div>
          `;
        }
    }
    
    // Render Prompts
    if (profilePromptsContainer) {
        profilePromptsContainer.innerHTML = '<h4>Prompts</h4>';
        if (currentUserProfile.prompts.prompt1) {
            profilePromptsContainer.innerHTML += `<div class="prompt-block"><p class="prompt-question">My favorite way to de-stress is...</p><p class="prompt-answer">“${currentUserProfile.prompts.prompt1}”</p></div>`;
        }
        if (currentUserProfile.prompts.prompt2) {
             profilePromptsContainer.innerHTML += `<div class="prompt-block"><p class="prompt-question">A patient story I'll never forget is...</p><p class="prompt-answer">“${currentUserProfile.prompts.prompt2}”</p></div>`;
        }
    }

    if (profileInterestsContainer) {
        profileInterestsContainer.innerHTML = '';
        currentUserProfile.interests.forEach(interest => {
            const tag = Object.assign(document.createElement('button'), { type: 'button', className: 'interest-tag active', textContent: interest });
            profileInterestsContainer.appendChild(tag);
        });
    }

    const badgesContainer = document.querySelector('#profile-page .badges-container');
    if (badgesContainer) {
        badgesContainer.innerHTML = '';
        allBadges.forEach(badgeInfo => {
            const badgeEl = document.createElement('div');
            badgeEl.title = badgeInfo.criteria;
            const hasBadge = currentUserProfile.earnedBadges.includes(badgeInfo.id);
            badgeEl.className = `badge ${hasBadge ? '' : 'locked'}`;
            badgeEl.innerHTML = `<i class="fas ${hasBadge ? badgeInfo.icon : 'fa-lock'} badge-icon ${hasBadge ? badgeInfo.color : ''}"></i><span class="badge-label">${badgeInfo.name}</span>`;
            badgesContainer.appendChild(badgeEl);
        });
    }
  }

  // --- MAIN APP NAVIGATION ---
  function showPage(pageId: string) {
    pages.forEach(page => page.classList.toggle('hidden', page.id !== pageId));
    if (pageId === 'gifts-page') renderGiftsPage();
    if (pageId === 'vent-page') renderVentPosts();
    if (pageId === 'likes-you-page') renderLikesYouPage();
    if (pageId === 'dashboard-page') renderDashboardPage();
    if (pageId === 'speed-dating-page') setupSpeedDatingLobby();
    if (pageId === 'home-page') renderHomePage();
    else if(speedDatingInterval) { // Stop timer when leaving page
        clearInterval(speedDatingInterval);
        speedDatingInterval = null;
    }
  }

  // Navigation function for compatibility
  function navigateTo(page: string) {
    const pageMap: { [key: string]: string } = {
      'home': 'home-page',
      'messages': 'messages-page',
      'profile': 'profile-page',
      'speed-dating': 'speed-dating-page',
      'gifts': 'gifts-page',
      'settings': 'settings-page'
    };

    const pageId = pageMap[page] || page;

    // Activate the appropriate nav button
    navButtons.forEach(btn => btn.classList.remove('active'));
    const targetButton = document.querySelector(`.nav-btn[data-page="${pageId}"]`);
    if (targetButton) {
      targetButton.classList.add('active');
    }

    showPage(pageId);
  }

  // Render home page function
  function renderHomePage() {
    console.log('Rendering home page...');
    loadSwipeCards();

    // Update any home page specific UI elements
    const swipeDeck = document.getElementById('swipe-deck');
    if (swipeDeck && users.length === 0) {
      swipeDeck.innerHTML = '<div class="no-cards-message">Loading users...</div>';
    }
  }

  navButtons.forEach(button => {
    button.addEventListener('click', () => {
      const pageId = (button as HTMLElement).dataset.page;
      if (pageId) {
        navButtons.forEach(btn => btn.classList.remove('active'));
        button.classList.add('active');
        showPage(pageId);
      }
    });
  });

  // --- Settings & Sub-page Navigation ---
  settingsButton?.addEventListener('click', () => { navButtons.forEach(btn => btn.classList.remove('active')); showPage('settings-page'); });
  settingsBackBtn?.addEventListener('click', () => (document.querySelector('.nav-btn.active') || document.querySelector('.nav-btn[data-page="home-page"]'))?.dispatchEvent(new MouseEvent('click')));

  // Logout functionality
  const logoutBtn = document.getElementById('logout-btn');
  logoutBtn?.addEventListener('click', async () => {
    try {
      await signOut(auth);
      // User will be redirected to welcome screen via onAuthStateChanged listener
      console.log('User logged out successfully');
    } catch (error) {
      console.error('Error signing out:', error);
      alert('Failed to logout. Please try again.');
    }
  });
  likesYouBtn?.addEventListener('click', () => showPage('likes-you-page'));
  likesYouBackBtn?.addEventListener('click', () => (document.querySelector('.nav-btn[data-page="home-page"]'))?.dispatchEvent(new MouseEvent('click')));
  
  giftsBackBtn?.addEventListener('click', () => (document.querySelector('.nav-btn[data-page="profile-page"]'))?.dispatchEvent(new MouseEvent('click'))); // Go to profile as nav is there now
  gotoVentBtn?.addEventListener('click', () => showPage('vent-page'));
  ventBackBtn?.addEventListener('click', () => showPage('settings-page'));
  gotoDashboardBtn?.addEventListener('click', () => showPage('dashboard-page'));
  dashboardBackBtn?.addEventListener('click', () => showPage('settings-page'));


  gotoFiltersBtn?.addEventListener('click', () => showPage('filters-page'));
  filtersBackBtn?.addEventListener('click', () => showPage('settings-page'));
  gotoBlockedUsersBtn?.addEventListener('click', () => { renderBlockedUsersPage(); showPage('blocked-users-page'); });
  blockedUsersBackBtn?.addEventListener('click', () => showPage('settings-page'));
  darkModeToggle?.addEventListener('change', () => applyDarkMode(darkModeToggle.checked));
  gotoVerificationBtn?.addEventListener('click', () => { renderVerificationModal(); verificationModal?.classList.remove('hidden'); });
  verificationModal?.addEventListener('click', (e) => { if (e.target === verificationModal || (e.target as HTMLElement).closest('.close-modal-btn')) verificationModal.classList.add('hidden'); });
  document.getElementById('goto-subscription-btn')?.addEventListener('click', () => showPage('subscription-page'));
  document.getElementById('subscription-back-btn')?.addEventListener('click', () => showPage('settings-page'));
  gotoEditProfileBtn?.addEventListener('click', () => {
    populateEditModal();
    editProfileModal?.classList.remove('hidden');
  });

  // --- CHAT LOGIC ---
  backToListBtn?.addEventListener('click', () => {
      chatView?.classList.add('hidden');
      messageListView?.classList.remove('hidden');
      currentChatUserId = null;
  });

  function renderMessageThreads() {
    if (!messageThreadsContainer) return;
    // Clear existing user threads
    messageThreadsContainer.querySelectorAll('.message-thread-item:not(#chatbot-thread)').forEach(el => el.remove());
    
    // For now, render threads for all users in the initial list
    users.forEach(user => {
      const threadEl = document.createElement('div');
      threadEl.className = 'message-thread-item';
      threadEl.dataset.userId = user.id;
      threadEl.innerHTML = `
        <img src="${user.avatar || user.img || 'https://placehold.co/60x60/00bcd4/FFFFFF?text=🏥'}"
             alt="${user.name}"
             loading="lazy"
             onerror="this.src='https://placehold.co/60x60/00bcd4/FFFFFF?text=🏥'"
             style="opacity: 0; transition: opacity 0.3s ease-in-out;"
             onload="this.style.opacity = 1;">
        <div class="thread-info">
          <div class="thread-name-wrapper">
            <div class="thread-name">${user.name}</div>
            <div class="unread-indicator"></div>
          </div>
          <div class="thread-preview">Click to start chatting...</div>
        </div>
      `;
      threadEl.addEventListener('click', () => openChat(user));
      messageThreadsContainer.appendChild(threadEl);
    });
  }

  async function openChat(user: any) {
    if (!user || !user.id) return;

    // Navigate to the messages page first
    showPage('messages-page');
    navButtons.forEach(btn => btn.classList.remove('active'));
    document.querySelector('.nav-btn[data-page="messages-page"]')?.classList.add('active');

    // Then open the specific chat view
    isChatbotActive = false;
    currentChatUserId = user.id;

    if (chatViewHeaderName) chatViewHeaderName.textContent = user.name;
    if (chatViewHeaderAvatar) chatViewHeaderAvatar.src = user.img;

    if (chatMessagesContainer) chatMessagesContainer.innerHTML = '';
    const chatId = getChatId(user.id);
    const messages = await loadMessages(chatId);
    messages.forEach(appendMessage);
    
    const videoCallBtn = document.getElementById('video-call-btn');
    const audioCallBtn = document.getElementById('audio-call-btn');
    videoCallBtn?.addEventListener('click', () => startCall('video', user));
    audioCallBtn?.addEventListener('click', () => startCall('audio', user));


    messageListView?.classList.add('hidden');
    chatView?.classList.remove('hidden');
  }

  async function handleSendMessage() {
      const messageText = chatInput?.value.trim();
      if (!messageText || !chatInput) return;

      if (isChatbotActive && chatbotSession) {
          appendMessage({ text: messageText, type: 'sent', status: 'read', timestamp: Date.now() });
          chatInput.value = '';
          handleChatbotResponse(messageText);
      } else {
          if (!currentChatUserId) return;
          const chatId = getChatId(currentChatUserId);
          const userMessage: Message = { text: messageText, type: 'sent', status: 'sent', timestamp: Date.now() };
          await saveMessage(chatId, userMessage);
          appendMessage(userMessage);
          chatInput.value = '';
          currentUserProfile.messagesSent = (currentUserProfile.messagesSent || 0) + 1;
      }
  }

  async function handleChatbotResponse(message: string) {
      if (!chatMessagesContainer || !chatbotSession) return;
      try {
          const response = await chatbotSession.sendMessage({ message: message });
          appendMessage({ text: response.text, type: 'received', status: 'read', timestamp: Date.now() });
      } catch (error) {
          console.error("Chatbot Error:", error);
          appendMessage({ text: "Sorry, I'm having trouble. Please try again.", type: 'received', status: 'read', timestamp: Date.now() });
      }
  }
  
  function appendMessage(message: Message) {
      if (!chatMessagesContainer) return;

      const wrapper = document.createElement('div');
      wrapper.className = `chat-bubble-wrapper ${message.type}`;
      
      const bubble = document.createElement('div');
      bubble.id = `msg-${message.timestamp}`;
      
      if (message.type === 'gift' && message.gift) {
          bubble.className = `chat-bubble gift-bubble`;
          bubble.innerHTML = `<span>${message.gift.icon}</span>`;
      } else {
          bubble.className = `chat-bubble`;
          bubble.innerHTML = `<span>${message.text}</span>`;
          if (message.type === 'sent') {
              bubble.innerHTML += `<div class="message-meta"><span class="message-timestamp">${new Date(message.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</span></div>`;
          }
          bubble.addEventListener('click', () => showReactionPicker(message.timestamp));
      }
      
      wrapper.appendChild(bubble);
      
      const reactionsDiv = document.createElement('div');
      reactionsDiv.className = 'chat-reactions';
      reactionsDiv.id = `reactions-${message.timestamp}`;
      if (message.reactions) renderReactions(reactionsDiv, message.reactions);
      wrapper.appendChild(reactionsDiv);
      
      chatMessagesContainer.appendChild(wrapper);
      chatMessagesContainer.scrollTop = chatMessagesContainer.scrollHeight;
  }
  
  async function showReactionPicker(timestamp: number) {
      const reactions = ['❤️', '😂', '👍', '😢', '😮'];
      // For simplicity, we'll just add a reaction directly.
      const chosenReaction = reactions[Math.floor(Math.random() * reactions.length)];
      if (!currentChatUserId) return;

      const chatId = getChatId(currentChatUserId);
      const messages = await loadMessages(chatId);
      const msgIndex = messages.findIndex(m => m.timestamp === timestamp);
      if (msgIndex === -1) return;

      if (!messages[msgIndex].reactions) messages[msgIndex].reactions = {};
      messages[msgIndex].reactions![chosenReaction] = (messages[msgIndex].reactions![chosenReaction] || 0) + 1;

      // Update the message in Firebase
      await updateMessage(chatId, messages[msgIndex]);
      const reactionsDiv = document.getElementById(`reactions-${timestamp}`);
      if (reactionsDiv) renderReactions(reactionsDiv, messages[msgIndex].reactions!);
  }

  function renderReactions(container: HTMLElement, reactions: Record<string, number>) {
    container.innerHTML = Object.entries(reactions).map(([emoji, count]) => `
      <div class="reaction">${emoji} <span class="reaction-count">${count > 1 ? count : ''}</span></div>
    `).join('');
  }


  // --- GIFT LOGIC & UI ---
  giftBtn?.addEventListener('click', () => { if(currentChatUserId) { renderSendGiftModal(currentChatUserId); sendGiftModal?.classList.remove('hidden'); } });
  closeSendGiftModalBtn?.addEventListener('click', () => sendGiftModal?.classList.add('hidden'));
  sendGiftModal?.addEventListener('click', (e) => { if (e.target === sendGiftModal) sendGiftModal?.classList.add('hidden'); });
  
  function updateGiftPointsDisplay() { if (giftPointsBalance) giftPointsBalance.textContent = currentUserProfile.giftPoints.toString(); }
  
  function watchAdForFreeGift(gift: Gift) {
      if (!watchAdModal) return;
      watchAdModal.classList.remove('hidden');
      if (watchAdTitle) watchAdTitle.textContent = `Acquiring ${gift.name}...`;
      if (watchAdCounter) watchAdCounter.textContent = "Loading real ad...";

      // Create larger AdSense ad slot for better visibility
      const adContainer = document.createElement('div');
      adContainer.id = 'gift-ad-container';
      adContainer.style.cssText = `
        width: 100%;
        min-height: 250px;
        margin: 20px 0;
        border: 2px solid #00bcd4;
        border-radius: 10px;
        padding: 10px;
        background: white;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
      `;

      adContainer.innerHTML = `
        <div style="margin-bottom: 10px; font-weight: bold; color: #333;">📺 Advertisement</div>
        <ins class="adsbygoogle"
             style="display:block; width: 100%; height: 200px;"
             data-ad-client="ca-pub-7587025688858323"
             data-ad-slot="4920991234"
             data-ad-format="rectangle"
             data-full-width-responsive="false"></ins>
      `;

      // Insert ad into modal before progress bar
      if (watchAdProgress && watchAdProgress.parentNode) {
        watchAdProgress.parentNode.insertBefore(adContainer, watchAdProgress);
      }

      try {
        console.log('Loading AdSense ad for gift:', gift.name);
        // Load AdSense ad
        ((window as any).adsbygoogle = (window as any).adsbygoogle || []).push({});

        if (watchAdCounter) watchAdCounter.textContent = "🎬 Watch the full ad to earn your gift!";

        // Countdown timer
        let timeLeft = 30;
        const countdown = setInterval(() => {
          timeLeft--;
          if (watchAdCounter) watchAdCounter.textContent = `🎬 Ad playing... ${timeLeft}s remaining`;

          if (timeLeft <= 0) {
            clearInterval(countdown);
            watchAdModal.classList.add('hidden');
            adContainer.remove();
            addGiftToSendableInventory(gift);
            showToast(`🎁 ${gift.name} acquired! Check your inventory.`);
          }
        }, 1000);

      } catch (error) {
        console.error('Error loading ad:', error);
        if (watchAdCounter) watchAdCounter.textContent = "Ad service unavailable - getting reward anyway!";
        // Fallback to instant reward if ad fails
        setTimeout(() => {
          watchAdModal.classList.add('hidden');
          adContainer.remove();
          addGiftToSendableInventory(gift);
          showToast(`${gift.name} acquired!`);
        }, 3000);
      }
  }

  function renderGiftsPage() {
    if (!freeGiftsGrid || !premiumGiftsGrid || !sendableInventoryGrid) return;
    updateGiftPointsDisplay();
    
    freeGiftsGrid.innerHTML = '';
    premiumGiftsGrid.innerHTML = '';
    [...freeGifts, ...premiumGifts].forEach(gift => {
        const item = document.createElement('div');
        item.className = 'gift-item';
        let actionsHTML = '';
        if (gift.type === 'free' && gift.points) {
            actionsHTML = `<button class="btn-buy-points" data-gift-name="${gift.name}"><i class="fas fa-coins"></i> ${gift.points}</button>`;
        } else if (gift.type === 'free') {
            actionsHTML = `<button class="btn-watch-ad" data-gift-name="${gift.name}">Watch Ad</button>`;
        } else {
             actionsHTML = `<div class="gift-price">${gift.price}</div>`;
             item.addEventListener('click', () => purchasePremiumGift(gift));
        }
        item.innerHTML = `<div class="gift-icon">${gift.icon}</div><div class="gift-name">${gift.name}</div>${actionsHTML}`;
        (gift.type === 'free' ? freeGiftsGrid : premiumGiftsGrid).appendChild(item);
    });

    freeGiftsGrid.querySelectorAll('.btn-buy-points').forEach(btn => btn.addEventListener('click', (e) => {
        const giftName = (e.currentTarget as HTMLElement).dataset.giftName;
        const gift = [...freeGifts, ...premiumGifts].find(g => g.name === giftName);
        if (gift && gift.points && currentUserProfile.giftPoints >= gift.points) {
            currentUserProfile.giftPoints -= gift.points;
            addGiftToSendableInventory(gift);
            updateGiftPointsDisplay();
            showToast(`${gift.name} acquired!`);
        } else { showToast("Not enough points!"); }
    }));
    
    freeGiftsGrid.querySelectorAll('.btn-watch-ad').forEach(btn => btn.addEventListener('click', (e) => {
        const giftName = (e.currentTarget as HTMLElement).dataset.giftName;
        const gift = freeGifts.find(g => g.name === giftName);
        if (gift) {
            watchAdForFreeGift(gift);
        }
    }));

    const sendableInventory = getSendableGiftInventory();
    sendableInventoryGrid.innerHTML = '';
    if (Object.keys(sendableInventory).length > 0) {
        emptySendableInventoryMessage?.classList.add('hidden');
        Object.values(sendableInventory).forEach(gift => sendableInventoryGrid.appendChild(createInventoryItem(gift)));
    } else { emptySendableInventoryMessage?.classList.remove('hidden'); }
  }

  function createInventoryItem(gift: Gift & { count: number }) {
    return Object.assign(document.createElement('div'), {
        className: 'inventory-item',
        innerHTML: `<div class="inventory-count">${gift.count}</div><div class="gift-icon">${gift.icon}</div><div class="gift-name">${gift.name}</div>`
    });
  }
  
  function purchasePremiumGift(gift: Gift) { /* ... existing logic ... */ }
  function handleStripePayment(e: Event) { /* ... existing logic ... */ }

  function renderSendGiftModal(recipientUserId: string) {
    const grid = document.getElementById('send-gift-inventory-grid');
    const emptyMsg = document.getElementById('empty-send-gift-inventory-message');
    if (!grid || !emptyMsg) return;

    const gifts = Object.values(getSendableGiftInventory());
    grid.innerHTML = '';
    emptyMsg.classList.toggle('hidden', gifts.length > 0);
    
    gifts.forEach(gift => {
        const item = createInventoryItem(gift);
        item.classList.add('gift-item');
        item.addEventListener('click', async () => await sendGiftFromInventory(gift, recipientUserId));
        grid.appendChild(item);
    });
  }

  // --- UI HELPERS ---
  function showToast(message: string, isError: boolean = false) {
      if (!toastNotification) return;
      toastNotification.textContent = message;
      toastNotification.classList.add('show');
      setTimeout(() => toastNotification.classList.remove('show'), 3000);
  }

  function createFallingObjects() {
    const container = document.getElementById('welcome-container');
    if (!container) return;
    const objects = [
        { char: '❤️', className: 'heart' },
        { char: '💊', className: 'pill' },
        { char: '🩹', className: 'bandaid' },
        { char: '✨', className: 'sparkle-fall' },
        { char: '⭐', className: 'star-fall' },
        { char: '💫', className: 'dizzy-fall' },
        { char: '🛏️', className: 'patient-bed' },
        { char: '🏥', className: 'hospital' },
        { char: '🩺', className: 'stethoscope' },
        { char: '💉', className: 'syringe' }
    ];
    
    const intervalId = setInterval(() => {
        if (container.classList.contains('hidden')) {
            clearInterval(intervalId);
            return;
        }
        
        const objData = objects[Math.floor(Math.random() * objects.length)];
        const el = document.createElement('div');
        el.textContent = objData.char;
        el.className = `falling-object ${objData.className}`;
        el.style.left = `${Math.random() * 100}%`;
        el.style.fontSize = `${Math.random() * 20 + 15}px`;
        el.style.animationDuration = `${Math.random() * 3 + 4}s`;
        el.style.animationDelay = `${Math.random() * 1}s`;

        container.appendChild(el);

        setTimeout(() => {
            el.remove();
        }, 8000); // Duration + Delay
    }, 400);
  }

  function createSparkleTrail() {
      const sparkleContainer = document.getElementById('sparkle-container');
      if (!sparkleContainer) return;
      const colors = ['#ffc700', '#ff5252', '#448aff', '#00e676', '#ff80ab', '#ffffff'];

      document.body.addEventListener('mousemove', (e) => {
          for (let i = 0; i < 5; i++) { // Create a burst of 5 sparkles
              const sparkle = document.createElement('div');
              sparkle.className = 'sparkle';
              sparkle.style.top = `${e.pageY}px`;
              sparkle.style.left = `${e.pageX}px`;
              
              const size = Math.random() * 8 + 4; // 4px to 12px
              sparkle.style.width = `${size}px`;
              sparkle.style.height = `${size}px`;
              sparkle.style.background = colors[Math.floor(Math.random() * colors.length)];

              const angle = Math.random() * 2 * Math.PI;
              const radius = Math.random() * 60 + 20; // Fly out further
              const xOffset = Math.cos(angle) * radius;
              const yOffset = Math.sin(angle) * radius;
              const duration = Math.random() * 0.6 + 0.4; // 0.4s to 1s

              sparkle.style.setProperty('--x-offset', `${xOffset}px`);
              sparkle.style.setProperty('--y-offset', `${yOffset}px`);
              sparkle.style.animationDuration = `${duration}s`;

              sparkleContainer.appendChild(sparkle);

              setTimeout(() => {
                  sparkle.remove();
              }, duration * 1000); 
          }
      });
  }

  // --- SWIPE CARD LOGIC ---
  const swipeDeck = document.getElementById('swipe-deck');
  let activeCard: HTMLElement | null = null, activeCardData: any = null, startX = 0, startY = 0, currentX = 0, currentY = 0, isDragging = false, wasDragged = false, lastSwipedUser: any = null;
  
  function createCard(user: typeof users[0]) {
    const card = document.createElement('div');
    card.className = 'swipe-card';
    if (user.boosted) card.classList.add('boosted');

    const avatarUrl = user.avatar || user.img || 'https://placehold.co/300x400/00bcd4/FFFFFF?text=🏥';

    card.innerHTML = `
      ${user.boosted ? `<div class="boost-indicator"><i class="fas fa-bolt"></i></div>` : ''}
      <img src="${avatarUrl}"
           alt="${user.name}"
           loading="lazy"
           onerror="this.src='https://placehold.co/300x400/00bcd4/FFFFFF?text=🏥'"
           style="opacity: 0; transition: opacity 0.3s ease-in-out;"
           onload="this.style.opacity = 1;">
      <div class="swipe-card-info">
        <h3>${user.name}, ${user.age}</h3>
        <p>${user.specialty} | ${user.location}</p>
      </div>
    `;
    (card as any).userData = user;
    return card;
  }
  
  function updateCardStackStyles() {
    if (!swipeDeck) return;
    const cards = Array.from(swipeDeck.querySelectorAll('.swipe-card')) as HTMLElement[];
    cards.forEach((card, index) => {
        const isTopCard = index === cards.length - 1;
        const isSecondCard = index === cards.length - 2;

        card.style.zIndex = `${10 + index}`;
        
        card.style.display = (isTopCard || isSecondCard) ? 'flex' : 'none';
        
        if (isTopCard) {
            card.style.transform = 'none';
            card.style.opacity = '1';
        } else if (isSecondCard) {
            card.style.transform = 'translateY(10px) scale(0.95)';
            card.style.opacity = '1';
        } else {
            card.style.opacity = '0';
        }
    });
  }

  function loadSwipeCards() {
    if (!swipeDeck) return;
    swipeDeck.innerHTML = '';
    const availableUsers = userList.filter(u => !isUserBlocked(u.id));
    if (availableUsers.length > 0) {
      [...availableUsers].reverse().forEach(user => swipeDeck.appendChild(createCard(user)));
    } else {
      swipeDeck.innerHTML = `<div class="placeholder-content"><i class="fas fa-user-friends placeholder-icon"></i><h3>That's everyone!</h3><p>You've seen all the profiles for now. Check back later for new people.</p></div>`;
    }
    updateCardStackStyles();
    setNextActiveCard();
  }
  
  function setNextActiveCard() {
    activeCard = swipeDeck?.querySelector('.swipe-card:last-child') as HTMLElement | null;
    if (activeCard) {
      activeCardData = (activeCard as any).userData;
      activeCard.addEventListener('pointerdown', onDragStart);
    }
  }

  function onDragStart(e: PointerEvent) {
    if (!activeCard || isDragging) return;
    isDragging = true;
    wasDragged = false;
    startX = e.clientX;
    startY = e.clientY;
    activeCard.style.transition = 'none';

    function onPointerMove(ev: PointerEvent) {
        if (!isDragging || !activeCard) return;
        currentX = ev.clientX - startX; 
        currentY = ev.clientY - startY;
        if (!wasDragged && (Math.abs(currentX) > 10 || Math.abs(currentY) > 10)) {
            wasDragged = true;
        }
        activeCard.style.transform = `translate(${currentX}px, ${currentY}px) rotate(${currentX * 0.1}deg)`;
    }

    function onPointerEnd() {
        document.removeEventListener('pointermove', onPointerMove);
        document.removeEventListener('pointerup', onPointerEnd);
        if (!isDragging) return;
        isDragging = false;
        if (wasDragged) {
            if (Math.abs(currentX) > 100) {
              swipeCard(currentX > 0 ? 1 : -1);
            } else {
              resetCardPosition();
            }
        } else {
            // This is a tap/click
            showUserProfileView(activeCardData);
            resetCardPosition(); // Reset just in case there was a tiny movement
        }
        currentX = 0;
        currentY = 0;
    }

    document.addEventListener('pointermove', onPointerMove);
    document.addEventListener('pointerup', onPointerEnd);
  }
  
  function swipeCard(direction: 1 | -1 | 2) { // 1: like, -1: pass, 2: super like
      if (!activeCard) return;
      
      activeCard.removeEventListener('pointerdown', onDragStart);

      const swipedUser = userList.find(u => u.id === activeCardData.id);
      if (swipedUser) { lastSwipedUser = swipedUser; userList = userList.filter(u => u.id !== swipedUser.id); }

      const flyoutX = (window.innerWidth / 2 + activeCard.offsetWidth) * (direction === -1 ? -1 : 1);
      activeCard.style.transition = 'transform 0.4s ease-out';
      activeCard.style.transform = `translate(${flyoutX}px, ${currentY * 2}px) rotate(${45 * (direction === -1 ? -1 : 1)}deg)`;
      
      if (direction === 1 || direction === 2) {
          // Check for mutual like to create a real match
          checkMutualLike(activeCardData, direction === 2 ? 'superlike' : 'like');
      } else if (direction === -1) {
          // Save pass action to prevent re-swiping
          savePassAction(activeCardData);
      }
      if (direction === 2) {
          showToast(`Super Liked ${activeCardData.name.split(' ')[0]}!`);
      }

      setTimeout(() => {
          activeCard?.remove();
          updateCardStackStyles();
          setNextActiveCard();
      }, 400);
  }

  function resetCardPosition() {
    if (!activeCard) return;
    activeCard.style.transition = 'transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275)';
    activeCard.style.transform = 'translate(0, 0) rotate(0deg)';
  }
  
  document.getElementById('pass-btn')?.addEventListener('click', () => swipeCard(-1));
  document.getElementById('like-btn')?.addEventListener('click', () => swipeCard(1));
  document.getElementById('super-like-btn')?.addEventListener('click', () => { if (currentUserProfile.superLikes > 0) { currentUserProfile.superLikes--; swipeCard(2); } else { showToast("No Super Likes left!"); }});
  document.getElementById('rewind-btn')?.addEventListener('click', () => { if(lastSwipedUser) { userList.push(lastSwipedUser); loadSwipeCards(); lastSwipedUser = null; } else { showToast("No one to rewind!"); } });
  
  // --- MATCH LOGIC ---
  async function checkMutualLike(likedUser: any, likeType: string) {
    if (!auth.currentUser) return;

    try {
      // First, check if user has already liked this profile
      const existingLikeDoc = doc(db, 'likes', `${auth.currentUser.uid}_${likedUser.uid}`);
      const existingLikeSnap = await getDoc(existingLikeDoc);

      if (existingLikeSnap.exists()) {
        showToast('You have already liked this profile!');
        return;
      }

      // Also check swipes collection for passes to prevent re-swiping
      const existingSwipeDoc = doc(db, 'swipes', `${auth.currentUser.uid}_${likedUser.uid}`);
      const existingSwipeSnap = await getDoc(existingSwipeDoc);

      if (existingSwipeSnap.exists()) {
        showToast('You have already swiped on this profile!');
        return;
      }

      // Save the current user's like
      const likeData = {
        likerId: auth.currentUser.uid,
        likedUserId: likedUser.uid,
        type: likeType,
        isMatched: false,
        createdAt: new Date()
      };

      await setDoc(existingLikeDoc, likeData);
      console.log('Like saved:', likeData);

      // Check if the other user has already liked this user
      const reverseLikeDoc = doc(db, 'likes', `${likedUser.uid}_${auth.currentUser.uid}`);
      const reverseLikeSnap = await getDoc(reverseLikeDoc);

      if (reverseLikeSnap.exists()) {
        console.log('Mutual like detected! Creating match...');

        // Update both likes to show they're matched
        await updateDoc(existingLikeDoc, { isMatched: true });
        await updateDoc(reverseLikeDoc, { isMatched: true });

        // Create a match document
        const matchData = {
          userIds: [auth.currentUser.uid, likedUser.uid],
          createdAt: new Date(),
          lastActivity: new Date(),
          status: 'active'
        };

        const matchId = `${[auth.currentUser.uid, likedUser.uid].sort().join('_')}`;
        const matchDocRef = doc(db, 'matches', matchId);
        await setDoc(matchDocRef, matchData);

        // Show match modal
        setTimeout(() => showMatchModal(likedUser), 300);
      } else {
        console.log('Like saved, waiting for mutual like...');
      }
    } catch (error) {
      console.error('Error checking mutual like:', error);
    }
  }

  async function savePassAction(passedUser: any) {
    if (!auth.currentUser) return;

    try {
      const swipeData = {
        swiperId: auth.currentUser.uid,
        swipedUserId: passedUser.uid,
        action: 'pass',
        createdAt: new Date()
      };

      const swipeDoc = doc(db, 'swipes', `${auth.currentUser.uid}_${passedUser.uid}`);
      await setDoc(swipeDoc, swipeData);
      console.log('Pass action saved:', swipeData);
    } catch (error) {
      console.error('Error saving pass action:', error);
    }
  }

  // --- MATCH MODAL & AI LOGIC ---
