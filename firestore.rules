rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection - allow CRUD for own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, list: if request.auth != null; // Allow reading all profiles for swiping
    }

    // Likes collection - allow checking mutual likes and creating likes
    match /likes/{likeId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.likerId;
      allow read: if request.auth != null && (request.auth.uid == resource.data.likerId || request.auth.uid == resource.data.likedUserId);
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.likerId;
      // Allow listing likes to check for mutual likes
      allow list: if request.auth != null;
    }

    // Matches collection
    match /matches/{matchId} {
      allow create: if request.auth != null &&
        (request.auth.uid in request.resource.data.users);
      allow read, update, delete: if request.auth != null &&
        (request.auth.uid in resource.data.users);
      // Allow listing matches for a user
      allow list: if request.auth != null;
    }

    // Chats collection - organized as chats/{chatId}/messages/{messageId}
    match /chats/{chatId} {
      // Allow creating chats if user is in participants
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.participants;
      // Allow reading and updating if user is participant (both for existing and new data)
      allow read, update: if request.auth != null && (
        (resource != null && request.auth.uid in resource.data.participants) ||
        (request.resource != null && request.auth.uid in request.resource.data.participants)
      );
      // Allow listing chats for real-time listeners
      allow list: if request.auth != null;

      // Messages subcollection within each chat
      match /messages/{messageId} {
        allow create: if request.auth != null && request.auth.uid == request.resource.data.senderId;
        allow read, list: if request.auth != null;
        allow update: if request.auth != null && (
          request.auth.uid == resource.data.senderId ||
          request.auth.uid == resource.data.receiverId ||
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
        );
      }
    }

    // Legacy Messages collection (keeping for backwards compatibility)
    match /messages/{messageId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.senderId;
      allow read, list: if request.auth != null && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId);
      allow update: if request.auth != null && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId);
    }

    // Gifts collection
    match /gifts/{giftId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.senderId;
      allow read, update, list: if request.auth != null && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId);
    }

    // Speed Dating Rooms collection
    match /speedDatingRooms/{roomId} {
      allow create: if request.auth != null &&
        (request.auth.uid == request.resource.data.creatorId || request.resource.data.creatorId == 'system');
      allow read, list: if request.auth != null;
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.creatorId || resource.data.creatorId == 'system');
      allow delete: if request.auth != null && request.auth.uid == resource.data.creatorId;
    }

    // Speed Dating Sessions collection
    match /speedDatingSessions/{sessionId} {
      allow create: if request.auth != null &&
        (request.auth.uid in request.resource.data.participants);
      allow read, update, list: if request.auth != null &&
        (request.auth.uid in resource.data.participants);
    }

    // Swipes collection
    match /swipes/{swipeId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.swiperId;
      allow read: if request.auth != null && (request.auth.uid == resource.data.swiperId || request.auth.uid == resource.data.swipedUserId);
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.swiperId;
      // Allow listing swipes to check for duplicates
      allow list: if request.auth != null;
    }

    // Vent Posts collection
    match /ventPosts/{postId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.authorId;
      allow read, list: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.authorId;
    }

    // Call Notifications collection - for video call notifications
    match /callNotifications/{notificationId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.callerId;
      allow read, list: if request.auth != null && (
        request.auth.uid == resource.data.callerId ||
        request.auth.uid == resource.data.targetUserId
      );
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.callerId ||
        request.auth.uid == resource.data.targetUserId
      );
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.callerId ||
        request.auth.uid == resource.data.targetUserId
      );
    }
  }
}