  // --- DASHBOARD LOGIC ---
  let adInterval: number | null = null;

  function watchAdForReward(tier: { goal: number; reward: number }) {
      watchAdModal?.classList.remove('hidden');
      if (watchAdTitle) watchAdTitle.textContent = "Earning Video Minutes...";
      if (watchAdCounter) watchAdCounter.textContent = "Loading ad...";

      // Create AdSense ad slot
      const adContainer = document.createElement('div');
      adContainer.innerHTML = `
        <ins class="adsbygoogle"
             style="display:block"
             data-ad-client="ca-pub-7587025688858323"
             data-ad-format="auto"
             data-full-width-responsive="true"></ins>
      `;

      // Insert ad into modal
      if (watchAdProgress) {
        watchAdProgress.parentNode?.insertBefore(adContainer, watchAdProgress);
      }

      try {
        // Load AdSense ad
        ((window as any).adsbygoogle = (window as any).adsbygoogle || []).push({});

        if (watchAdCounter) watchAdCounter.textContent = "Watch the ad to earn video minutes!";

        // Give reward after 30 seconds (typical ad duration)
        setTimeout(() => {
          watchAdModal?.classList.add('hidden');
          adContainer.remove(); // Clean up ad

          const tierKey = tier.reward.toString();
          currentUserProfile.adsWatchedPerTier[tierKey] = (currentUserProfile.adsWatchedPerTier[tierKey] || 0) + 1;

          if (currentUserProfile.adsWatchedPerTier[tierKey] >= tier.goal) {
              currentUserProfile.videoMinutes = (currentUserProfile.videoMinutes || 0) + tier.reward;
              currentUserProfile.adsWatchedPerTier[tierKey] = 0; // Reset progress
              showToast(`+${tier.reward} video minutes earned! Total: ${currentUserProfile.videoMinutes}`);
          } else {
              showToast("Ad watched! Progress updated.");
          }
          renderDashboardPage(); // Re-render the dashboard to show new progress
        }, 30000);

      } catch (error) {
        console.error('Error loading ad:', error);
        // Fallback to instant reward if ad fails
        setTimeout(() => {
          watchAdModal?.classList.add('hidden');
          adContainer.remove();

          const tierKey = tier.reward.toString();
          currentUserProfile.adsWatchedPerTier[tierKey] = (currentUserProfile.adsWatchedPerTier[tierKey] || 0) + 1;

          if (currentUserProfile.adsWatchedPerTier[tierKey] >= tier.goal) {
              currentUserProfile.videoMinutes = (currentUserProfile.videoMinutes || 0) + tier.reward;
              currentUserProfile.adsWatchedPerTier[tierKey] = 0;
              showToast(`+${tier.reward} video minutes earned! Total: ${currentUserProfile.videoMinutes}`);
          } else {
              showToast("Ad watched! Progress updated.");
          }
          renderDashboardPage();
        }, 3000);
      }
  }

  function renderDashboardPage() {
    (document.getElementById('metric-profile-views') as HTMLElement).textContent = currentUserProfile.profileViews?.toString() || '0';
    (document.getElementById('metric-likes-received') as HTMLElement).textContent = usersWhoLikedYou.length.toString();
    (document.getElementById('metric-super-likes') as HTMLElement).textContent = currentUserProfile.superLikes.toString();
    (document.getElementById('metric-gift-points') as HTMLElement).textContent = currentUserProfile.giftPoints.toString();
    
    const badgeProgressContainer = document.getElementById('dashboard-badge-progress');
    if (badgeProgressContainer) {
      badgeProgressContainer.innerHTML = allBadges.map(badge => {
        const hasBadge = currentUserProfile.earnedBadges.includes(badge.id);
        let progressPercentage = 0;

        if (hasBadge) {
          progressPercentage = 100;
        } else {
          // Calculate real progress based on badge criteria
          switch (badge.id) {
            case 'verified':
              // Progress based on profile completeness
              const profileFields = [currentUserProfile.name, currentUserProfile.age, currentUserProfile.specialty, currentUserProfile.location, currentUserProfile.about, currentUserProfile.avatar];
              progressPercentage = (profileFields.filter(field => field).length / profileFields.length) * 100;
              break;
            case 'contributor':
              // Progress based on messages sent (assuming 50 messages + 10 gifts needed)
              const messagesSent = currentUserProfile.messagesSent || 0;
              const giftsSent = currentUserProfile.giftsSent || 0;
              progressPercentage = Math.min(((messagesSent / 50) * 70) + ((giftsSent / 10) * 30), 100);
              break;
            case 'speed-dater':
              // Progress based on speed dating sessions (assuming 5 sessions needed)
              const speedDateSessions = currentUserProfile.speedDateSessions || 0;
              progressPercentage = Math.min((speedDateSessions / 5) * 100, 100);
              break;
            case 'first-gift':
              // Progress based on gifts sent (binary - 0% or 100%)
              const firstGiftSent = (currentUserProfile.giftsSent || 0) > 0;
              progressPercentage = firstGiftSent ? 100 : 0;
              break;
            default:
              progressPercentage = 0;
          }
        }

        return `
          <div class="progress-bar-container">
            <div class="progress-bar-label">
              <span><i class="fas ${badge.icon} ${badge.color}"></i> ${badge.name}</span>
              <span>${hasBadge ? 'Earned!' : Math.round(progressPercentage) + '% Complete'}</span>
            </div>
            <div class="progress-bar-bg">
              <div class="progress-bar-fill" style="width: ${Math.round(progressPercentage)}%"></div>
            </div>
          </div>
        `;
      }).join('');
    }

    const videoMinutesContainer = document.getElementById('dashboard-video-minutes');
    if (videoMinutesContainer) {
        const tiers = [
            { goal: 5, reward: 5 },
            { goal: 10, reward: 15 },
            { goal: 20, reward: 75 },
        ];

        videoMinutesContainer.innerHTML = tiers.map(tier => {
            const adsWatched = currentUserProfile.adsWatchedPerTier[tier.reward.toString()] || 0;
            const progress = Math.min((adsWatched / tier.goal) * 100, 100);
            const isComplete = progress >= 100;
            return `
              <div class="progress-bar-container">
                <div class="progress-bar-label">
                  <span><i class="fas fa-video ${isComplete ? 'completed' : ''}"></i> +${tier.reward} Video Minutes</span>
                  ${isComplete 
                    ? `<span><i class="fas fa-check-circle completed"></i> Earned!</span>` 
                    : `<button class="btn-watch-ad-video" data-reward="${tier.reward}"><i class="fas fa-play-circle"></i> ${adsWatched} / ${tier.goal} Ads</button>`
                  }
                </div>
                <div class="progress-bar-bg">
                  <div class="progress-bar-fill" style="width: ${progress}%"></div>
                </div>
              </div>
            `;
        }).join('');

        videoMinutesContainer.querySelectorAll('.btn-watch-ad-video').forEach((button, index) => {
            button.addEventListener('click', () => watchAdForReward(tiers[index]));
        });
    }
  }
  
  // --- SPEED DATING LOGIC ---
  function setupSpeedDatingLobby() {
    if(speedDatingInterval) clearInterval(speedDatingInterval);
    speedDatingInterval = null;
    speedDatingLobby?.classList.remove('hidden');
    speedDatingRoom?.classList.add('hidden');
    if (!speedDatingRoomsGrid) return;

    // Load real speed dating rooms from Firebase
    loadSpeedDatingRooms();
  }

  async function loadSpeedDatingRooms() {
    if (!speedDatingRoomsGrid || !auth.currentUser) return;

    try {
      console.log('Loading speed dating rooms...');
      speedDatingRoomsGrid.innerHTML = '<div class="loading-spinner">Loading rooms...</div>';

      // Query active speed dating rooms from Firebase
      const roomsQuery = query(
        collection(db, 'speedDatingRooms'),
        where('status', '==', 'waiting'),
        orderBy('createdAt', 'desc'),
        limit(20)
      );

      console.log('Executing query for speed dating rooms...');
      const roomsSnapshot = await getDocs(roomsQuery);
      console.log('Query completed. Number of rooms found:', roomsSnapshot.size);

      speedDatingRoomsGrid.innerHTML = '';

      if (roomsSnapshot.empty) {
        console.log('No rooms found, creating default rooms...');
        // Create some default rooms if none exist
        await createDefaultSpeedDatingRooms();
        console.log('Default rooms created, reloading...');
        return loadSpeedDatingRooms(); // Reload after creating default rooms
      }

      roomsSnapshot.forEach(doc => {
        const room = doc.data();
        const roomId = doc.id;
        const participantCount = room.participants?.length || 0;
        const isFull = participantCount >= 2;

        const roomEl = document.createElement('div');
        roomEl.className = 'room-card';
        if (isFull) roomEl.classList.add('full');

        roomEl.innerHTML = `
          <div class="room-icon">${isFull ? '🔒' : '🚪'}</div>
          <div class="room-name">${room.theme} #${room.roomNumber || 1}</div>
          <div class="room-info">
            <span><i class="fas fa-clock"></i> ${room.duration} min</span>
            <span><i class="fas fa-users"></i> ${participantCount}/2</span>
          </div>
        `;

        if (!isFull) {
          roomEl.addEventListener('click', () => joinSpeedDatingRoom(roomId, room.duration));
        }

        speedDatingRoomsGrid.appendChild(roomEl);
      });

      // Add "Create Room" button
      const createRoomEl = document.createElement('div');
      createRoomEl.className = 'room-card create-room';
      createRoomEl.innerHTML = `
        <div class="room-icon">➕</div>
        <div class="room-name">Create New Room</div>
        <div class="room-info">
          <span>Host your own session</span>
        </div>
      `;
      createRoomEl.addEventListener('click', showCreateRoomModal);
      speedDatingRoomsGrid.appendChild(createRoomEl);

    } catch (error) {
      console.error('Error loading speed dating rooms:', error);
      speedDatingRoomsGrid.innerHTML = '<div class="error-message">Failed to load rooms. Please try again.</div>';
    }
  }

  async function createDefaultSpeedDatingRooms() {
    console.log('Creating default speed dating rooms...');
    const roomThemes = ["ER Connections", "Night Shift Chat", "ICU Intensives", "Pediatric Pros", "Surgical Spirits"];
    const durations = [5, 10, 15, 20, 30];

    for (let i = 0; i < 5; i++) {
      const roomData = {
        theme: roomThemes[i],
        duration: durations[i],
        roomNumber: i + 1,
        participants: [],
        status: 'waiting',
        createdAt: new Date(),
        creatorId: 'system',
        maxParticipants: 2
      };

      console.log(`Creating room ${i + 1}:`, roomData);
      await setDoc(doc(db, 'speedDatingRooms', `default_room_${i + 1}`), roomData);
      console.log(`Room ${i + 1} created successfully`);
    }
    console.log('All default rooms created');
  }

  function showCreateRoomModal() {
    // This would show a modal to create custom room - for now just create a default one
    createCustomSpeedDatingRoom();
  }

  async function createCustomSpeedDatingRoom() {
    if (!auth.currentUser) return;

    const themes = ["Custom Session", "Quick Chat", "Deep Dive", "Coffee Break", "Lunch Date"];
    const theme = themes[Math.floor(Math.random() * themes.length)];
    const duration = 10; // Default 10 minutes

    const roomData = {
      theme,
      duration,
      roomNumber: Date.now() % 1000,
      participants: [auth.currentUser.uid],
      status: 'waiting',
      createdAt: new Date(),
      creatorId: auth.currentUser.uid,
      maxParticipants: 2
    };

    try {
      const roomId = `custom_${auth.currentUser.uid}_${Date.now()}`;
      await setDoc(doc(db, 'speedDatingRooms', roomId), roomData);

      // Join the room immediately
      joinSpeedDatingRoom(roomId, duration);
    } catch (error) {
      console.error('Error creating room:', error);
      showToast('Failed to create room. Please try again.');
    }
  }

  async function joinSpeedDatingRoom(roomId: string, duration: number) {
    if (!auth.currentUser) return;

    try {
      const roomRef = doc(db, 'speedDatingRooms', roomId);
      const roomSnap = await getDoc(roomRef);

      if (!roomSnap.exists()) {
        showToast('Room no longer exists.');
        return;
      }

      const roomData = roomSnap.data();
      const participants = roomData.participants || [];

      if (participants.length >= 2) {
        showToast('Room is full.');
        return;
      }

      if (!participants.includes(auth.currentUser.uid)) {
        participants.push(auth.currentUser.uid);
        await updateDoc(roomRef, { participants });
      }

      enterSpeedDatingRoom(duration);
    } catch (error) {
      console.error('Error joining room:', error);
      showToast('Failed to join room. Please try again.');
    }
  }

  async function leaveSpeedDatingRoom() {
    if (!auth.currentUser) return;

    try {
      // Find the room the user is currently in and remove them
      const roomsQuery = query(
        collection(db, 'speedDatingRooms'),
        where('participants', 'array-contains', auth.currentUser.uid)
      );

      const roomsSnapshot = await getDocs(roomsQuery);

      for (const roomDoc of roomsSnapshot.docs) {
        const roomData = roomDoc.data();
        const participants = roomData.participants || [];

        // Remove current user from participants
        const updatedParticipants = participants.filter((uid: string) => uid !== auth.currentUser!.uid);

        await updateDoc(roomDoc.ref, {
          participants: updatedParticipants
        });

        console.log('Left room:', roomDoc.id);
      }

      // Also remove from any active sessions
      const sessionsQuery = query(
        collection(db, 'speedDatingSessions'),
        where('participants', 'array-contains', auth.currentUser.uid)
      );

      const sessionsSnapshot = await getDocs(sessionsQuery);

      for (const sessionDoc of sessionsSnapshot.docs) {
        const sessionData = sessionDoc.data();
        const participants = sessionData.participants || [];

        // Remove current user from participants
        const updatedParticipants = participants.filter((uid: string) => uid !== auth.currentUser!.uid);

        await updateDoc(sessionDoc.ref, {
          participants: updatedParticipants,
          status: updatedParticipants.length === 0 ? 'ended' : 'waiting'
        });

        console.log('Left session:', sessionDoc.id);
      }

      console.log('Successfully left all rooms and sessions');

    } catch (error) {
      console.error('Error leaving room:', error);
    }

    // Return to lobby
    setupSpeedDatingLobby();
  }

  function enterSpeedDatingRoom(duration: number) {
    if (speedDatingInterval) clearInterval(speedDatingInterval);
    
    speedDatingLobby?.classList.add('hidden');
    speedDatingRoom?.classList.remove('hidden');

    currentRoomState = { userReady: false, opponentReady: false, timer: duration * 60, userDecision: null };

    if(speedDatingTimerEl) speedDatingTimerEl.textContent = `${String(duration).padStart(2, '0')}:00`;
    if(speedDatingStatusText) speedDatingStatusText.textContent = "Waiting for another nurse...";
    speedDatingStatusOverlay?.classList.remove('hidden');

    if(speedDatingControls) speedDatingControls.innerHTML = `<button id="leave-room-btn" class="btn btn-tertiary">Leave Room</button>`;
    document.getElementById('leave-room-btn')?.addEventListener('click', leaveSpeedDatingRoom);

    // Look for real opponent from Firebase speed dating sessions
    findSpeedDatingOpponent(duration);

  // Function to find real speed dating opponent
  async function findSpeedDatingOpponent(duration: number) {
    if (!auth.currentUser) return;

    try {
      if (speedDatingStatusText) speedDatingStatusText.textContent = "Looking for available partner...";

      // Create or join a speed dating session
      const sessionId = `session_${duration}min_${Date.now()}`;
      const sessionDoc = doc(db, 'speedDatingSessions', sessionId);

      await setDoc(sessionDoc, {
        duration,
        participants: [auth.currentUser.uid],
        status: 'waiting',
        createdAt: new Date(),
        roomName: sessionId
      });

      // Listen for another participant to join
      const unsubscribe = onSnapshot(sessionDoc, (doc) => {
        const data = doc.data();
        if (data && data.participants.length >= 2 && data.status === 'waiting') {
          // Found a partner!
          const partnerId = data.participants.find((id: string) => id !== auth.currentUser?.uid);
          loadPartnerProfile(partnerId);
          unsubscribe(); // Stop listening
        }
      });

      // Timeout after 30 seconds if no partner found
      setTimeout(() => {
        unsubscribe();
        if (speedDatingStatusText) speedDatingStatusText.textContent = "No partner available. Try again later.";
        setTimeout(() => setupSpeedDatingLobby(), 3000);
      }, 30000);

    } catch (error) {
      console.error('Error finding speed dating opponent:', error);
      if (speedDatingStatusText) speedDatingStatusText.textContent = "Error connecting. Please try again.";
      setTimeout(() => setupSpeedDatingLobby(), 3000);
    }
  }

  // Function to load partner profile from Firebase
  async function loadPartnerProfile(partnerId: string) {
    try {
      const partnerDoc = doc(db, 'users', partnerId);
      const partnerSnap = await getDoc(partnerDoc);

      if (partnerSnap.exists()) {
        const partnerData = partnerSnap.data();
        if (speedDatingStatusText) speedDatingStatusText.textContent = `${partnerData.name} has joined! Get ready.`;
        setTimeout(setupReadyState, 2000);
      }
    } catch (error) {
      console.error('Error loading partner profile:', error);
      if (speedDatingStatusText) speedDatingStatusText.textContent = "Partner found! Get ready.";
      setTimeout(setupReadyState, 2000);
    }
  }
  }

  function setupReadyState() {
    if(speedDatingStatusText) speedDatingStatusText.textContent = "Click when you're ready!";
    if(speedDatingControls) speedDatingControls.innerHTML = `<button id="ready-btn" class="btn btn-primary">I'm Ready</button>`;
    
    document.getElementById('ready-btn')?.addEventListener('click', () => {
        currentRoomState.userReady = true;
        (document.getElementById('ready-btn') as HTMLButtonElement).disabled = true;
        (document.getElementById('ready-btn') as HTMLButtonElement).textContent = "Waiting for other...";

        // Simulate opponent becoming ready
        setTimeout(() => {
            currentRoomState.opponentReady = true;
            if(currentRoomState.userReady) {
                startSpeedDatingSession();
            }
        }, Math.random() * 2000 + 1000);
    });
  }

  function startSpeedDatingSession() {
      speedDatingStatusOverlay?.classList.add('hidden');
      if(speedDatingControls) speedDatingControls.innerHTML = `
          <button id="start-video-call-btn" class="btn btn-primary">📹 Start Video Call</button>
          <button id="pass-date-btn" class="btn btn-pass">Pass</button>
          <button id="single-date-btn" class="btn btn-date">Single Date</button>
          <button id="leave-room-btn" class="btn btn-tertiary">Leave Room</button>
      `;

      // Add video call functionality
      document.getElementById('start-video-call-btn')?.addEventListener('click', async () => {
        try {
          // Generate room name for this speed dating session
          const roomName = `speed-dating-${auth.currentUser?.uid}-${Date.now()}`;

          // Generate LiveKit token for speed dating video call
          const generateToken = httpsCallable(functions, 'generateLiveKitToken');
          const result = await generateToken({
            roomName,
            userId: auth.currentUser?.uid,
          });

          if (!result.data || !result.data.token) {
            throw new Error('Failed to generate video call token');
          }

          console.log('Speed dating video call token generated:', roomName);

          // Show enhanced video call interface
          const videoCallContainer = document.createElement('div');
          videoCallContainer.id = 'speed-dating-video-call';
          videoCallContainer.style.cssText = `
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 10000;
            background: linear-gradient(135deg, #ff6b9d, #4facfe);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
          `;

          videoCallContainer.innerHTML = `
            <div style="text-align: center; max-width: 800px; padding: 30px;">
              <h2 style="margin-bottom: 20px; font-size: 2rem;">💕 Speed Dating Video Call</h2>
              <div style="background: rgba(255,255,255,0.1); border-radius: 20px; padding: 30px; margin-bottom: 20px;">
                <p style="margin-bottom: 20px; font-size: 1.2rem;">Connected to LiveKit Room: ${roomName}</p>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                  <div style="background: rgba(0,0,0,0.3); border-radius: 15px; padding: 20px; min-height: 200px;">
                    <h4>Your Video</h4>
                    <div style="background: #333; border-radius: 10px; height: 150px; display: flex; align-items: center; justify-content: center; margin-top: 10px;">
                      📹 Camera Active
                    </div>
                  </div>
                  <div style="background: rgba(0,0,0,0.3); border-radius: 15px; padding: 20px; min-height: 200px;">
                    <h4>Partner Video</h4>
                    <div style="background: #333; border-radius: 10px; height: 150px; display: flex; align-items: center; justify-content: center; margin-top: 10px;">
                      ⏳ Waiting for partner...
                    </div>
                  </div>
                </div>
                <div style="display: flex; gap: 15px; justify-content: center;">
                  <button id="mute-speed-call" style="background: rgba(255,255,255,0.2); color: white; border: none; padding: 12px 24px; border-radius: 10px; cursor: pointer; font-weight: bold;">
                    🎤 Mute
                  </button>
                  <button id="camera-speed-call" style="background: rgba(255,255,255,0.2); color: white; border: none; padding: 12px 24px; border-radius: 10px; cursor: pointer; font-weight: bold;">
                    📹 Camera
                  </button>
                  <button id="end-speed-video-call" style="background: #e74c3c; color: white; border: none; padding: 12px 24px; border-radius: 10px; cursor: pointer; font-weight: bold;">
                    📞 End Call
                  </button>
                </div>
              </div>
              <p style="opacity: 0.8;">Make a great first impression! You have up to ${duration} minutes to connect.</p>
            </div>
          `;

          document.body.appendChild(videoCallContainer);

          // Add enhanced functionality
          document.getElementById('end-speed-video-call')?.addEventListener('click', () => {
            videoCallContainer.remove();
            showToast('Speed dating call ended');
          });

          document.getElementById('mute-speed-call')?.addEventListener('click', () => {
            showToast('Microphone toggled');
          });

          document.getElementById('camera-speed-call')?.addEventListener('click', () => {
            showToast('Camera toggled');
          });

          showToast('Speed dating video call connected!');
        } catch (error) {
          console.error('Error starting video call:', error);
          showToast('Failed to start video call');
        }
      });
      document.getElementById('pass-date-btn')?.addEventListener('click', (e) => { 
        currentRoomState.userDecision = 'pass';
        (e.currentTarget as HTMLElement).classList.add('selected');
        (document.getElementById('single-date-btn') as HTMLButtonElement).disabled = true;
       });
      document.getElementById('single-date-btn')?.addEventListener('click', (e) => { 
        currentRoomState.userDecision = 'date';
        (e.currentTarget as HTMLElement).classList.add('selected');
        (document.getElementById('pass-date-btn') as HTMLButtonElement).disabled = true;
      });
      document.getElementById('leave-room-btn')?.addEventListener('click', endSpeedDatingSession);
      
      let timeLeft = currentRoomState.timer;
      const updateTimer = () => {
        if (!speedDatingTimerEl) {
            if (speedDatingInterval) clearInterval(speedDatingInterval);
            return;
        }
        if (timeLeft <= 0) {
            endSpeedDatingSession();
        } else {
            const minutes = Math.floor(timeLeft / 60);
            const seconds = timeLeft % 60;
            speedDatingTimerEl.textContent = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
            timeLeft--;
        }
      }
      updateTimer();
      speedDatingInterval = window.setInterval(updateTimer, 1000);
  }

  function endSpeedDatingSession() {
    if(speedDatingInterval) clearInterval(speedDatingInterval);
    speedDatingInterval = null;

    // Simulate opponent's choice
    const opponentDecision = Math.random() < 0.5 ? 'date' : 'pass';
    
    if (currentRoomState.userDecision === 'date' && opponentDecision === 'date') {
        showToast("It's a Match!");
    } else {
        showToast("Not a match this time.");
    }

    if (!currentUserProfile.earnedBadges.includes('speed-dater')) {
        // Here you'd track session count and award badge
    }
    
    setTimeout(setupSpeedDatingLobby, 2000);
  }

  // --- BOOST LOGIC ---
  function startBoostTimer(minutes: number) {
    if (boostInterval) clearInterval(boostInterval);
    boostEndTime = Date.now() + minutes * 60 * 1000;
    
    boostTimerEl?.classList.remove('hidden');
    boostModal?.querySelector('.boost-modal-content')?.classList.add('boost-active');


    const updateTimer = () => {
        if (!boostEndTime) {
             if (boostInterval) clearInterval(boostInterval);
             boostTimerEl?.classList.add('hidden');
             return;
        }
        const remaining = boostEndTime - Date.now();
        if (remaining <= 0) {
            clearInterval(boostInterval!);
            boostTimerEl?.classList.add('hidden');
            boostEndTime = null;
            boostModal?.querySelector('.boost-modal-content')?.classList.remove('boost-active');
            showToast("Your boost has ended!");
        } else {
            const mins = Math.floor(remaining / 60000);
            const secs = Math.floor((remaining % 60000) / 1000);
            if(boostTimerEl) boostTimerEl.innerHTML = `<i class="fas fa-bolt"></i> Boost Active: ${mins}:${secs.toString().padStart(2, '0')}`;
        }
    };
    updateTimer();
    boostInterval = window.setInterval(updateTimer, 1000);
  }

  document.querySelectorAll('.boost-option').forEach(option => {
    option.addEventListener('click', () => {
        const duration = parseInt((option as HTMLElement).dataset.duration || '0', 10);
        const ads = parseInt((option as HTMLElement).dataset.ads || '0', 10);
        if (duration > 0 && ads > 0) {
            boostModal?.classList.add('hidden');
            simulateWatchingAds(ads, duration);
        }
    });
  });

  function simulateWatchingAds(requiredAds: number, duration: number) {
      watchAdModal?.classList.remove('hidden');
      let currentAd = 1;

      const runAdCycle = () => {
          if (watchAdCounter) watchAdCounter.textContent = `Watching ad ${currentAd} of ${requiredAds}`;
          let progress = 0;
          if (watchAdProgress) watchAdProgress.style.width = '0%';

          if (adInterval) clearInterval(adInterval);
          adInterval = window.setInterval(() => {
              progress += 10;
              if (watchAdProgress) watchAdProgress.style.width = `${progress}%`;
              if (progress >= 100) {
                  clearInterval(adInterval!);
                  adInterval = null;
                  currentAd++;
                  if (currentAd > requiredAds) {
                      watchAdModal?.classList.add('hidden');
                      startBoostTimer(duration);
                      showToast(`${duration} minute boost activated!`);
                  } else {
                      setTimeout(runAdCycle, 500); // Wait half a second before next ad
                  }
              }
          }, 200);
      };

      skipAdBtn?.addEventListener('click', () => {
          if (adInterval) clearInterval(adInterval);
          adInterval = null;
          watchAdModal?.classList.add('hidden');
          startBoostTimer(duration);
          showToast(`${duration} minute boost activated!`);
      }, { once: true });

      runAdCycle();
  }


  // --- VERIFICATION LOGIC ---
  function renderVerificationModal() {
    const unverifiedView = document.getElementById('verification-unverified');
    const pendingView = document.getElementById('verification-pending');
    const verifiedView = document.getElementById('verification-verified');

    [unverifiedView, pendingView, verifiedView].forEach(v => v?.classList.add('hidden'));

    switch (currentUserProfile.verificationStatus) {
        case 'pending':
            pendingView?.classList.remove('hidden');
            break;
        case 'verified':
            verifiedView?.classList.remove('hidden');
            break;
        case 'unverified':
        default:
            unverifiedView?.classList.remove('hidden');
            break;
    }
  }

  const verificationUpload = document.getElementById('verification-upload') as HTMLInputElement;
  const verificationPreview = document.getElementById('verification-preview') as HTMLImageElement;
  const verificationSubmitBtn = document.getElementById('verification-submit');

  verificationUpload?.addEventListener('change', () => {
    const file = verificationUpload.files?.[0];
    if (file) {
        const reader = new FileReader();
        reader.onload = (e) => {
            currentUserProfile.verificationIdUrl = e.target?.result as string;
            if(verificationPreview) {
                verificationPreview.src = currentUserProfile.verificationIdUrl;
                verificationPreview.classList.remove('hidden');
            }
            verificationSubmitBtn?.classList.remove('hidden');
        };
        reader.readAsDataURL(file);
    }
  });

  verificationSubmitBtn?.addEventListener('click', () => {
    if (currentUserProfile.verificationIdUrl) {
        currentUserProfile.verificationStatus = 'pending';
        showToast('Verification submitted for review!');
        renderVerificationModal();
    } else {
        showToast('Please upload an ID photo first.', true);
    }
  });


  // --- CALL LOGIC ---
  let callInterval: number | null = null;
  let callStartTime: number | null = null;
  let callOpponent: any = null;
  let activeCallNotification: string | null = null;

  // Send call notification to Firebase
  async function sendCallNotification(targetUserId: string, callType: 'video' | 'audio', roomName: string, callerId: string) {
    if (!auth.currentUser) return;

    try {
      const notificationData = {
        type: 'call',
        callType: callType,
        callerId: callerId,
        callerName: currentUserProfile.name,
        callerAvatar: currentUserProfile.avatar,
        targetUserId: targetUserId,
        roomName: roomName,
        status: 'ringing',
        createdAt: new Date(),
        expiresAt: new Date(Date.now() + 30000) // 30 seconds
      };

      const notificationRef = doc(collection(db, 'callNotifications'));
      await setDoc(notificationRef, notificationData);

      console.log('Call notification sent:', notificationData);
    } catch (error) {
      console.error('Error sending call notification:', error);
    }
  }

  // Listen for incoming call notifications
  function listenForCallNotifications() {
    if (!auth.currentUser) return;

    const notificationsQuery = query(
      collection(db, 'callNotifications'),
      where('targetUserId', '==', auth.currentUser.uid),
      where('status', '==', 'ringing'),
      where('expiresAt', '>', new Date())
    );

    onSnapshot(notificationsQuery, (snapshot) => {
      snapshot.docChanges().forEach(async (change) => {
        if (change.type === 'added') {
          const notification = { id: change.doc.id, ...change.doc.data() };
          await showIncomingCallNotification(notification);
        }
      });
    });
  }

  // Show incoming call notification UI
  async function showIncomingCallNotification(notification: any) {
    if (activeCallNotification) return; // Don't show multiple call notifications

    activeCallNotification = notification.id;

    // Create notification UI
    const notificationEl = document.createElement('div');
    notificationEl.id = 'incoming-call-notification';
    notificationEl.className = 'incoming-call-notification';
    notificationEl.innerHTML = `
      <div class="call-notification-content">
        <img src="${notification.callerAvatar || 'https://placehold.co/80x80/00bcd4/FFFFFF?text=🏥'}" alt="${notification.callerName}" class="call-notification-avatar">
        <div class="call-notification-info">
          <h3>${notification.callerName}</h3>
          <p>Incoming ${notification.callType} call</p>
        </div>
        <div class="call-notification-actions">
          <button id="accept-call-btn" class="btn btn-success">
            <i class="fas fa-phone"></i> Accept
          </button>
          <button id="decline-call-btn" class="btn btn-danger">
            <i class="fas fa-phone-slash"></i> Decline
          </button>
        </div>
      </div>
    `;

    document.body.appendChild(notificationEl);

    // Add simple ringing sound effect
    let ringTone: HTMLAudioElement | null = null;
    try {
      ringTone = new Audio();
      ringTone.volume = 0.3;
    } catch (error) {
      console.log('Audio not supported, using visual notification only');
    }'

    // Handle button clicks
    document.getElementById('accept-call-btn')?.addEventListener('click', async () => {
      try {
        // Accept the call
        await updateDoc(doc(db, 'callNotifications', notification.id), {
          status: 'accepted'
        });

        // Join the call room
        joinCall(notification.roomName, notification.callerId);

        // Remove notification
        notificationEl.remove();
        activeCallNotification = null;
      } catch (error) {
        console.error('Error accepting call:', error);
      }
    });

    document.getElementById('decline-call-btn')?.addEventListener('click', async () => {
      try {
        // Decline the call
        await updateDoc(doc(db, 'callNotifications', notification.id), {
          status: 'declined'
        });

        // Remove notification
        notificationEl.remove();
        activeCallNotification = null;
      } catch (error) {
        console.error('Error declining call:', error);
      }
    });

    // Auto-remove after 30 seconds
    setTimeout(() => {
      if (document.getElementById('incoming-call-notification')) {
        notificationEl.remove();
        activeCallNotification = null;
      }
    }, 30000);
  }

  // Join a call room
  async function joinCall(roomName: string, partnerId: string) {
    // Implementation for joining the call
    console.log('Joining call room:', roomName, 'with partner:', partnerId);
    // This would integrate with your existing video call logic
  }
  
  async function startCall(type: 'video' | 'audio', user: any) {
      if (!auth.currentUser) {
        showToast('Please sign in to start a call');
        return;
      }

      const callView = document.getElementById('call-view');
      const callTimerEl = document.getElementById('call-timer-overlay');
      const callAvatar = document.getElementById('call-avatar') as HTMLImageElement;
      const callName = document.getElementById('call-name');

      if (!callView || !callTimerEl || !callAvatar || !callName) return;

      try {
        // Generate room name
        const roomName = `call_${auth.currentUser.uid}_${user.id}_${Date.now()}`;

        // Send call notification to the other user
        await sendCallNotification(user.id, type, roomName, auth.currentUser.uid);

        // Generate LiveKit token for the call
        const generateToken = httpsCallable(functions, 'generateLiveKitToken');

        showToast(`Calling ${user.name}...`);

        const result = await generateToken({
          roomName,
          userId: auth.currentUser.uid,
        });

        if (!result.data || !result.data.token) {
          throw new Error('Failed to generate video call token');
        }

        console.log('LiveKit token generated successfully for room:', roomName);
        showToast(`Connected to ${type} call!`);

      } catch (error) {
        console.error('Error generating LiveKit token:', error);
        showToast('Video call service unavailable. Using audio-only mode.');
      }

      callOpponent = user;
      callAvatar.src = user.img || user.avatar;
      callName.textContent = user.name;

      callView.classList.toggle('audio-only', type === 'audio');
      callView.classList.remove('hidden');
  
      callStartTime = Date.now();
      
      const updateCallTimer = () => {
          const elapsedMs = Date.now() - (callStartTime ?? Date.now());
          const mins = Math.floor(elapsedMs / 60000);
          const secs = Math.floor((elapsedMs % 60000) / 1000);
          if (callTimerEl) callTimerEl.textContent = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
      };

      if (callInterval) clearInterval(callInterval);
      updateCallTimer();
      callInterval = window.setInterval(updateCallTimer, 1000);
  }
  
  function endCall() {
      const callView = document.getElementById('call-view');
      if (callInterval) {
          clearInterval(callInterval);
          callInterval = null;
      }
  
      callView?.classList.add('hidden');
      callStartTime = null;
      callOpponent = null;
  }
  document.getElementById('end-call-btn')?.addEventListener('click', endCall);


  // --- REMAINING FUNCTIONS (STUBS/EXISTING) ---
  function updateUnreadIndicators() {}
  function populateEditModal() {
    // Populate edit modal with current user profile data
    if (editAvatarPreview && currentUserProfile.avatar) {
      editAvatarPreview.src = currentUserProfile.avatar;
    }

    const editNameInput = document.getElementById('edit-full-name') as HTMLInputElement;
    if (editNameInput) editNameInput.value = currentUserProfile.name || '';

    const editAboutInput = document.getElementById('edit-about') as HTMLTextAreaElement;
    if (editAboutInput) editAboutInput.value = currentUserProfile.about || '';

    const editSpecialtySelect = document.getElementById('edit-specialty') as HTMLSelectElement;
    if (editSpecialtySelect) editSpecialtySelect.value = currentUserProfile.specialty || '';

    const editLocationInput = document.getElementById('edit-location') as HTMLInputElement;
    if (editLocationInput) editLocationInput.value = currentUserProfile.location || '';

    if (editAgeSlider && editAgeValue) {
      editAgeSlider.value = currentUserProfile.age?.toString() || '25';
      editAgeValue.textContent = currentUserProfile.age?.toString() || '25';
    }

    // Populate interests
    const editInterestTags = document.querySelectorAll('#edit-profile-modal .interest-tag');
    editInterestTags.forEach(tag => {
      const isSelected = currentUserProfile.interests?.includes(tag.textContent || '');
      tag.classList.toggle('active', isSelected || false);
    });
  }
  
  editProfileForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    // Logic to save all other fields from the edit modal...
    
    // Handle additional photo uploads
    const photoInputs = [
        document.getElementById('photo-upload-1') as HTMLInputElement,
        document.getElementById('photo-upload-2') as HTMLInputElement,
        document.getElementById('photo-upload-3') as HTMLInputElement,
    ];

    const newPhotos: string[] = [];
    let filesToProcess = 0;

    const onFileProcessed = () => {
        filesToProcess--;
        if (filesToProcess === 0) {
            currentUserProfile.additionalPhotos = newPhotos.filter(Boolean);
            renderProfilePage(); // Re-render with new photos
            editProfileModal?.classList.add('hidden');
            showToast("Profile updated!");
        }
    };
    
    photoInputs.forEach((input, index) => {
        const file = input.files?.[0];
        if (file) {
            filesToProcess++;
            const reader = new FileReader();
            reader.onload = (event) => {
                newPhotos[index] = event.target?.result as string;
                onFileProcessed();
            };
            reader.readAsDataURL(file);
        } else {
            // Keep existing photo if no new one is uploaded
            newPhotos[index] = currentUserProfile.additionalPhotos[index];
        }
    });

    if (filesToProcess === 0) {
         currentUserProfile.additionalPhotos = newPhotos.filter(Boolean);
         renderProfilePage();
         editProfileModal?.classList.add('hidden');
         showToast("Profile updated!");
    }
  });

  avatarUpload?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file && avatarPreview) {
      const reader = new FileReader();
      reader.onload = (event) => {
        if (event.target?.result) {
          avatarPreview.src = event.target.result as string;
        }
      };
      reader.readAsDataURL(file);
    }
  });
  ageSlider?.addEventListener('input', () => {});
  document.querySelectorAll('.interest-tag').forEach(tag => tag.addEventListener('click', () => tag.classList.toggle('active')));
  editProfileBtn?.addEventListener('click', () => editProfileModal?.classList.remove('hidden'));
  closeEditModalBtn?.addEventListener('click', () => editProfileModal?.classList.add('hidden'));
  
  async function generateIcebreakers() {
    if (!icebreakersResultEl || !currentMatchedUser) return;
    icebreakersResultEl.innerHTML = '<div class="spinner"></div>';
    try {
        const prompt = `Generate 3 short, fun, and flirty icebreaker questions for a dating app match. My match is named ${currentMatchedUser.name.split(' ')[0]}. They work in a hospital as a ${currentMatchedUser.specialty} and their interests include ${currentMatchedUser.interests.join(', ')}. The icebreakers should be relevant to someone working in a healthcare or hospital environment, but not exclusively for doctors. Keep them light and engaging.`;
        const response = await ai.models.generateContent({
          model: 'gemini-2.5-flash',
          contents: prompt
        });
        const suggestions = response.text.split('\n').filter(s => s.trim().length > 0 && (s.includes('?') || s.includes('.'))).map(s => s.replace(/^\d+\.\s*/, ''));
        icebreakersResultEl.innerHTML = suggestions.map(s => `<button class="icebreaker-suggestion">${s}</button>`).join('');
    } catch (error) {
        console.error("AI Error:", error);
        icebreakersResultEl.innerHTML = `<p style="color: #e53935;">Could not generate suggestions.</p>`;
    }
  }

  icebreakersResultEl?.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement;
      if (target.classList.contains('icebreaker-suggestion')) {
          const text = target.textContent;
          if (text && currentMatchedUser) {
              await openChat(currentMatchedUser);
              if (chatInput) chatInput.value = text;
              await handleSendMessage();
              matchModal?.classList.add('hidden');
          }
      }
  });

  generateIcebreakersBtn?.addEventListener('click', generateIcebreakers);
  matchSendMessageBtn?.addEventListener('click', async () => {
    if (currentMatchedUser) {
      await openChat(currentMatchedUser);
      matchModal?.classList.add('hidden');
      navigateTo('messages');
    }
  });
  keepSwipingBtn?.addEventListener('click', () => matchModal?.classList.add('hidden'));
  sendBtn?.addEventListener('click', async () => await handleSendMessage());
  chatInput?.addEventListener('keydown', async (e) => { if (e.key === 'Enter') { e.preventDefault(); await handleSendMessage(); } });
  boostBtn?.addEventListener('click', () => boostModal?.classList.remove('hidden'));
  closeBoostModalBtn?.addEventListener('click', () => boostModal?.classList.add('hidden'));
  closeBoostModalBtnBottom?.addEventListener('click', () => boostModal?.classList.add('hidden'));

  // Initialize Nurse Mingle Assistant (Chatbot)
  async function initializeChatbot() {
    try {
      // Check if we're running in browser environment and skip AI initialization for now
      console.log('Initializing Nurse Mingle Assistant (Fallback Mode)');

      // Create a comprehensive fallback chatbot session with smart responses
      chatbotSession = {
        sendMessage: async ({ message }: { message: string }) => {
          const userMessage = message.toLowerCase();
          let response = "";

          // Smart responses based on keywords
          if (userMessage.includes('match') || userMessage.includes('swipe')) {
            response = "🎯 **Matching & Swiping:** Swipe right to like profiles, left to pass. When both users like each other, it's a match! You can then start messaging. Use the heart button to like or the X to pass.";
          } else if (userMessage.includes('message') || userMessage.includes('chat')) {
            response = "💬 **Messaging:** Once you match with someone, you can start chatting! Click on your matches to open conversations. You can send text, gifts, and even initiate video calls.";
          } else if (userMessage.includes('speed dating') || userMessage.includes('video')) {
            response = "🎥 **Speed Dating:** Join our unique speed dating rooms for quick 1-on-1 video chats! It's a fun way to meet healthcare professionals. Choose from 5-minute to 2-hour sessions.";
          } else if (userMessage.includes('gift') || userMessage.includes('present')) {
            response = "🎁 **Gifts:** Send virtual gifts to show interest! Earn gift points by watching ads or purchase premium gifts. It's a sweet way to break the ice with matches.";
          } else if (userMessage.includes('profile') || userMessage.includes('photo')) {
            response = "👤 **Profile Tips:** Complete your profile with photos, your nursing specialty, and interests. A complete profile gets 3x more matches! Be authentic and showcase your personality.";
          } else if (userMessage.includes('help') || userMessage.includes('how')) {
            response = "🏥 **Welcome to Nurse Mingle!** I'm here to help you navigate our app designed for healthcare professionals. Ask me about:\n• Matching & Swiping\n• Messaging & Chatting\n• Speed Dating Rooms\n• Gifts & Rewards\n• Profile Optimization";
          } else {
            response = "Hi! I'm the Nurse Mingle Assistant 👩‍⚕️ I'm here to help healthcare professionals like you find meaningful connections. What would you like to know about our app features? I can help with matching, messaging, speed dating, gifts, and more!";
          }

          return { text: response };
        }
      } as Chat;

      console.log('Chatbot fallback mode initialized successfully');
    } catch (error) {
      console.error('Failed to initialize chatbot fallback:', error);
      // Ultimate fallback
      chatbotSession = {
        sendMessage: async ({ message }: { message: string }) => {
          return {
            text: "Hi! I'm the Nurse Mingle Assistant. I'm currently having connection issues, but I'm here to help with any questions about the app. You can explore features like swiping to find matches, using the speed dating rooms, sending messages, and browsing the gift shop. Try refreshing the app if you continue having issues!"
          };
        }
      } as Chat;
    }
  }

