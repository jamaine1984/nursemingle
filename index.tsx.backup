  // --- FIREBASE AUTHENTICATION LISTENER ---
  onAuthStateChanged(auth, async (user) => {
    console.log('onAuthStateChanged triggered');
    console.log('User:', user);
    console.log('userRequestedAuth:', userRequestedAuth);
    console.log('isLoginAction:', isLoginAction);
    console.log('isSignUpAction:', isSignUpAction);

    if (user) {
      console.log('User signed in:', user.uid);
      console.log('User email:', user.email);

      // Only auto-redirect if user manually requested auth OR if this is a login action
      if (userRequestedAuth || isLoginAction) {
        console.log('User requested auth or login action - proceeding with flow');
        // Check if user has completed profile setup
        try {
          console.log('Checking user profile in Firestore...');
          const userDoc = doc(db, 'users', user.uid);
          const userSnap = await getDoc(userDoc);
          console.log('User document exists:', userSnap.exists());

          if (userSnap.exists()) {
            const userData = userSnap.data();
            console.log('Existing user found:', userData);

            // If this is a login action, always go to home (existing users)
            if (isLoginAction) {
              console.log('Login action detected, going to home...', { isLoginAction, isSignUpAction, userData });
              currentUserProfile = { ...currentUserProfile, ...userData };

              console.log('Loading Firebase data...');
              await initializeFirebaseData();
              console.log('Firebase data loaded successfully');

              console.log('Updating UI for successful login...');
              console.log('UI elements:', {
                welcomeContainer: !!welcomeContainer,
                authContainer: !!authContainer,
                profileSetupContainer: !!profileSetupContainer,
                appShell: !!appShell
              });

              welcomeContainer?.classList.add('hidden');
              authContainer?.classList.add('hidden');
              profileSetupContainer?.classList.add('hidden');
              appShell?.classList.remove('hidden');

              console.log('Navigating to home page...');
              navigateTo('home');

              // Render profile page to load user image and info
              console.log('Rendering profile page with user data...');
              renderProfilePage();

              // Reset flags after successful navigation
              isLoginAction = false;
              isSignUpAction = false;
              userRequestedAuth = false;
              console.log('Login completed successfully!');
            } else {
              // Check if user has completed profile setup (for signup)
              if (userData && userData.name && userData.age && userData.specialty && userData.location) {
                // User has completed profile - load data and go to app
                console.log('User profile complete, loading app...');
                currentUserProfile = { ...currentUserProfile, ...userData };
                await initializeFirebaseData();
                welcomeContainer?.classList.add('hidden');
                authContainer?.classList.add('hidden');
                profileSetupContainer?.classList.add('hidden');
                appShell?.classList.remove('hidden');
                navigateTo('home');

                // Render profile page to load user image and info
                console.log('Rendering profile page with user data...');
                renderProfilePage();
                // Reset flags after successful navigation
                isLoginAction = false;
                isSignUpAction = false;
              } else {
                // User exists but profile incomplete - show profile setup
                console.log('User profile incomplete, showing profile setup...');
                welcomeContainer?.classList.add('hidden');
                authContainer?.classList.add('hidden');
                appShell?.classList.add('hidden');
                profileSetupContainer?.classList.remove('hidden');
              }
            }
          } else {
            // New user - show profile setup
            console.log('New user, showing profile setup...');
            welcomeContainer?.classList.add('hidden');
            authContainer?.classList.add('hidden');
            appShell?.classList.add('hidden');
            profileSetupContainer?.classList.remove('hidden');
          }
        } catch (error) {
          console.error('Error checking user profile:', error);
          // Fallback to profile setup for safety
          welcomeContainer?.classList.add('hidden');
          authContainer?.classList.add('hidden');
          appShell?.classList.add('hidden');
          profileSetupContainer?.classList.remove('hidden');
        }
      } else {
        // Initial page load with authenticated user - load profile data but stay on welcome screen
        console.log('Page refreshed with authenticated user - loading profile data');
        try {
          const userDoc = doc(db, 'users', user.uid);
          const userSnap = await getDoc(userDoc);

          if (userSnap.exists()) {
            const userData = userSnap.data();
            console.log('Loading profile data for refreshed user:', userData);
            currentUserProfile = { ...currentUserProfile, ...userData };

            // Initialize Firebase data but don't show app yet
            await initializeFirebaseData();
            console.log('Profile data loaded successfully on refresh');
          }
        } catch (error) {
          console.error('Error loading profile on refresh:', error);
        }
      }
    } else {
      console.log('User signed out');
      // Show welcome screen
      appShell?.classList.add('hidden');
      profileSetupContainer?.classList.add('hidden');
      authContainer?.classList.add('hidden');
      welcomeContainer?.classList.remove('hidden');
    }

    // Mark that initial load is complete
    isInitialLoad = false;
  });
