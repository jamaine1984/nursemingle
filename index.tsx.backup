document.addEventListener('DOMContentLoaded', () => {

  // --- LAZY LOADING LOTTIE ANIMATION ---
  function initializeLottieAnimation() {
    const lottieContainer = document.getElementById('lottie-container');
    const lottieAnimation = document.getElementById('lottie-animation');
    const lottieSkeleton = document.querySelector('.lottie-skeleton');
    const lottieError = document.getElementById('lottie-error');

    if (!lottieAnimation) return;

    // Load animation after 1 second delay for better UX
    setTimeout(async () => {
      try {
        // Get animation URL from data attribute
        const animationUrl = lottieAnimation.getAttribute('data-src');
        if (!animationUrl) {
          throw new Error('No animation URL provided');
        }

        // Set up timeout for animation loading
        const timeoutPromise = new Promise((_, reject) =>
          setTimeout(() => reject(new Error('Animation load timeout')), 5000)
        );

        // Create load promise
        const loadPromise = new Promise((resolve, reject) => {
          const loadHandler = () => {
            lottieAnimation.removeEventListener('load', loadHandler);
            resolve(true);
          };
          const errorHandler = () => {
            lottieAnimation.removeEventListener('error', errorHandler);
            reject(new Error('Failed to load animation'));
          };

          lottieAnimation.addEventListener('load', loadHandler);
          lottieAnimation.addEventListener('error', errorHandler);

          // Set the source to trigger loading
          lottieAnimation.setAttribute('src', animationUrl);
        });

        // Wait for either successful load or timeout
        await Promise.race([loadPromise, timeoutPromise]);

        // Remove skeleton and show animation
        if (lottieSkeleton) {
          lottieSkeleton.style.display = 'none';
        }
        lottieAnimation.style.opacity = '1';

        // Add subtle glow effect
        lottieAnimation.style.filter = 'drop-shadow(0 0 10px rgba(233, 30, 99, 0.3))';

      } catch (error) {
        console.warn('Lottie animation failed to load:', error);

        // Hide skeleton and show error/fallback
        if (lottieSkeleton) {
          lottieSkeleton.style.display = 'none';
        }
        lottieAnimation.style.display = 'none';
        lottieError.style.display = 'flex';

        // Add gentle pulse to fallback
        const fallbackIcon = lottieError.querySelector('.fallback-icon');
        if (fallbackIcon) {
          fallbackIcon.style.animation = 'pulse 2s infinite';
        }
      }
    }, 1000);
  }

  // --- ELEMENT SELECTORS --
